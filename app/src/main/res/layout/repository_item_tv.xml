<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/repository_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_tv_settings_category_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:nextFocusRight="@id/action_settings"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="18dp"
    android:paddingBottom="14dp">

    <!-- 1. Left Icon in Glass Frame -->
    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_tv_card_action_btn"
        android:padding="8dp">

        <ImageView
            android:id="@+id/entry_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_github_logo" />
    </FrameLayout>

    <!-- 2. Center Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Title & Version Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/main_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#E9EAEE"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Test Repository" />

            <TextView
                android:id="@+id/ext_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tv_badge_pill"
                android:textColor="#818CF8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="v1.0"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/nsfw_marker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tv_badge_pill"
                android:text="@string/is_adult"
                android:textColor="#EF4444"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Metadata Pills Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lang_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_tv_badge_pill"
                android:textColor="#9BA0A4"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="🇺🇸 English"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/ext_filesize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_tv_badge_pill"
                android:textColor="#9BA0A4"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="2.4 MB"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/ext_votes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9BA0A4"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="Rating: 4.8" />
        </LinearLayout>

        <!-- Subtitle / URL / Description -->
        <TextView
            android:id="@+id/sub_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#9BA0A4"
            android:textSize="12.5sp"
            tools:text="https://github.com/recloudstream/cloudstream-extensions" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/repository_name_text"
            style="@style/SmallBlackButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            tools:text="Repository name" />
    </LinearLayout>

    <!-- 3. Right Action Pills -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginStart="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/action_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_tv_card_action_btn"
            android:clickable="true"
            android:contentDescription="@string/title_settings"
            android:focusable="true"
            android:nextFocusLeft="@id/repository_item_root"
            android:nextFocusRight="@id/action_button"
            android:padding="10dp"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_baseline_tune_24"
            app:tint="#E9EAEE"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/action_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_tv_card_action_btn"
            android:clickable="true"
            android:contentDescription="@string/download"
            android:focusable="true"
            android:nextFocusLeft="@id/action_settings"
            android:padding="10dp"
            app:tint="#E9EAEE"
            tools:src="@drawable/ic_baseline_delete_outline_24" />
    </LinearLayout>

</LinearLayout>
