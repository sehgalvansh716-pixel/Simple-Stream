<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tv_download_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <!-- 2:3 Portrait CardView Container with Non-Clipping Boundaries -->
    <androidx.cardview.widget.CardView
        android:id="@+id/background_card"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:elevation="2dp"
        app:cardMaxElevation="4dp"
        android:duplicateParentState="true"
        android:foreground="@drawable/outline_drawable"
        app:cardBackgroundColor="#14161D"
        app:cardCornerRadius="12dp"
        app:cardPreventCornerOverlap="false">

        <!-- High-Res Poster Image -->
        <ImageView
            android:id="@+id/download_header_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@string/episode_poster_img_des"
            tools:src="@drawable/example_poster" />

        <!-- Unfocused Bottom Vignette Shadow -->
        <ImageView
            android:id="@+id/card_bottom_shadow"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_gravity="bottom"
            android:clickable="false"
            android:focusable="false"
            android:src="@drawable/title_shadow" />

        <!-- Top-Right Status Badge / Multi-Episode Indicator -->
        <TextView
            android:id="@+id/download_header_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_tv_episode_badge"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="12 EPS" />

        <!-- Unfocused Bottom Metadata (Title + File Size) -->
        <LinearLayout
            android:id="@+id/card_unfocused_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/download_header_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:textColor="#E9EAEE"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/google_sans"
                tools:text="Inception" />

            <TextView
                android:id="@+id/download_header_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:textColor="#9BA0A4"
                android:textSize="10sp"
                tools:text="2.4 GB" />
        </LinearLayout>

        <!-- Focused Dimmer Overlay -->
        <View
            android:id="@+id/card_focus_dimmer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#73000000"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Focused Center Info Container (Play Icon + Centered Title + Episodes/Size) -->
        <LinearLayout
            android:id="@+id/card_focus_info"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Centered Circular White Play/Open Button -->
            <ImageView
                android:id="@+id/card_play_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_tv_card_play_circle"
                android:paddingStart="13dp"
                android:paddingEnd="11dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_tv_play_black"
                android:elevation="4dp"
                android:contentDescription="@string/home_play" />

            <!-- Focused Title (Full White Bold) -->
            <TextView
                android:id="@+id/card_focused_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/google_sans"
                tools:text="Inception" />

            <!-- Focused Info Subtitle Pill -->
            <TextView
                android:id="@+id/card_focused_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_tv_episode_badge"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:textColor="#E0E0E0"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="12 Episodes • 2.4 GB" />
        </LinearLayout>

        <!-- Watch / Download Progress Indicator -->
        <FrameLayout
            android:id="@+id/watch_progress_container"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/download_header_episode_progress"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:progressTint="#6366F1"
                android:progressBackgroundTint="#33FFFFFF"
                tools:progress="60" />
        </FrameLayout>

        <!-- Multi-Delete Checkbox (Top-Left) -->
        <CheckBox
            android:id="@+id/delete_checkbox"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:focusable="false"
            android:clickable="false"
            android:visibility="gone" />

        <!-- Download Action Button (Hidden by default, used for status / pie button) -->
        <com.lagradost.cloudstream3.ui.download.button.PieFetchButton
            android:id="@+id/download_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:visibility="gone" />

        <!-- Navigation Arrow indicator for series with child episodes -->
        <ImageView
            android:id="@+id/download_header_goto_child"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="6dp"
            android:src="@drawable/ic_baseline_keyboard_arrow_right_24"
            app:tint="#D1D5DB"
            android:visibility="gone"
            android:contentDescription="@null" />
    </androidx.cardview.widget.CardView>
</LinearLayout>
