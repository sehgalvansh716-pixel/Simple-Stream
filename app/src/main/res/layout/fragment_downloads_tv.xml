<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/download_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07090D"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".ui.download.DownloadFragment">

    <!-- ======================================================== -->
    <!-- 1. 60FPS AMBIENT VIDEO LOOP & ATMOSPHERIC SCRIM           -->
    <!-- ======================================================== -->
    <TextureView
        android:id="@+id/tv_downloads_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/tv_downloads_video_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_tv_search_video_overlay" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80070A0F" />

    <!-- ======================================================== -->
    <!-- 2. MAIN CONTENT CONTAINER                                 -->
    <!-- ======================================================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="44dp"
        android:paddingEnd="44dp"
        android:paddingTop="22dp">

        <!-- ==================================================== -->
        <!-- TOP HEADER: Back, Logo, Title (Left aligned)         -->
        <!-- ==================================================== -->
        <LinearLayout
            android:id="@+id/download_tv_top_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="12dp">

            <!-- Circular Glass Back Button (38x38dp) -->
            <ImageView
                android:id="@+id/download_tv_back"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_tv_circular_glass_btn"
                android:clickable="true"
                android:contentDescription="@string/go_back"
                android:defaultFocusHighlightEnabled="false"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_baseline_arrow_back_24"
                android:nextFocusDown="@id/download_appbar"
                app:tint="#FFFFFF" />

            <!-- App Logo Emblem (38x38dp) -->
            <ImageView
                android:id="@+id/download_tv_logo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="14dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/splash_logo_white" />

            <!-- Page Title -->
            <TextView
                android:id="@+id/download_tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:fontFamily="@font/google_sans"
                android:text="@string/title_downloads"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ==================================================== -->
        <!-- MULTI-DELETE HEADER (Visible during selection mode)  -->
        <!-- ==================================================== -->
        <LinearLayout
            android:id="@+id/download_delete_appbar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_tv_info_card_glass"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnCancel"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_tv_circular_glass_btn"
                android:contentDescription="@string/cancel"
                android:src="@drawable/ic_baseline_close_24"
                android:padding="6dp"
                android:focusable="true"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/selectItemsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="@string/downloads_delete_select"
                android:textColor="#E9EAEE"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnDelete"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_tv_danger_action_pill"
                android:text="@string/delete"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:focusable="true" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnToggleAll"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_tv_download_action_pill"
                android:text="@string/select_all"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:focusable="true" />
        </LinearLayout>

        <!-- ==================================================== -->
        <!-- LIQUID-GLASS STORAGE & DOWNLOAD STATS CARD           -->
        <!-- ==================================================== -->
        <LinearLayout
            android:id="@+id/download_appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tv_info_card_glass"
            android:focusable="true"
            android:clickable="true"
            android:orientation="horizontal"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:nextFocusUp="@id/download_tv_back"
            android:nextFocusDown="@id/btn_tv_pause_all">

            <!-- Storage Information Block -->
            <LinearLayout
                android:id="@+id/download_storage_appbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Header Row: Title & Legend -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/google_sans"
                        android:text="@string/download_storage_text"
                        android:textColor="#E9EAEE"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Shimmer placeholder while loading storage -->
                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/download_loading_bytes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        app:shimmer_auto_start="true"
                        app:shimmer_base_alpha="0.2"
                        app:shimmer_duration="@integer/loading_time"
                        tools:ignore="MissingClass">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Calculating Storage..."
                            android:textColor="#9BA0A4"
                            android:textSize="12sp" />
                    </com.facebook.shimmer.ShimmerFrameLayout>
                </LinearLayout>

                <!-- Storage Progress Bar -->
                <LinearLayout
                    android:id="@+id/download_bytes_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginBottom="8dp"
                        app:cardBackgroundColor="#26FFFFFF"
                        app:cardCornerRadius="4dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/download_used"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.4"
                                android:background="#6366F1" />

                            <View
                                android:id="@+id/download_app"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.2"
                                android:background="#10B981" />

                            <View
                                android:id="@+id/download_free"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.4"
                                android:background="#374151" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Storage Legend Text Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Used Indicator -->
                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/storage_bar_left_box"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/download_used_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#C0C5CC"
                            android:textSize="11sp"
                            android:fontFamily="@font/google_sans"
                            tools:text="Used • 30.58 GB" />

                        <!-- App Indicator -->
                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/storage_bar_mid_box"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/download_app_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#C0C5CC"
                            android:textSize="11sp"
                            android:fontFamily="@font/google_sans"
                            tools:text="App • 3.20 GB" />

                        <!-- Free Indicator -->
                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/storage_bar_right_box"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/download_free_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#C0C5CC"
                            android:textSize="11sp"
                            android:fontFamily="@font/google_sans"
                            tools:text="Free • 58.12 GB" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Vertical Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="48dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="#1FFFFFFF" />

            <!-- Queue Status Action Pill Button -->
            <LinearLayout
                android:id="@+id/download_queue_button"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_tv_download_action_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/baseline_downloading_24"
                    app:tint="#6366F1" />

                <TextView
                    android:id="@+id/download_queue_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/google_sans"
                    android:text="@string/download_queue"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==================================================== -->
        <!-- BATCH ACTION PILLS ROW                               -->
        <!-- ==================================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginBottom="12dp">

            <!-- Pause All Pill -->
            <TextView
                android:id="@+id/btn_tv_pause_all"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_tv_download_action_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/pause"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@font/google_sans"
                android:nextFocusUp="@id/download_appbar"
                android:nextFocusRight="@id/btn_tv_resume_all"
                android:nextFocusDown="@id/download_list"
                app:drawableStartCompat="@drawable/ic_baseline_pause_24"
                app:drawableTint="#FFFFFF"
                android:drawablePadding="6dp" />

            <!-- Resume All Pill -->
            <TextView
                android:id="@+id/btn_tv_resume_all"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_tv_download_action_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/resume"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@font/google_sans"
                android:nextFocusLeft="@id/btn_tv_pause_all"
                android:nextFocusUp="@id/download_appbar"
                android:nextFocusRight="@id/btn_tv_clear_completed"
                android:nextFocusDown="@id/download_list"
                app:drawableStartCompat="@drawable/ic_baseline_play_arrow_24"
                app:drawableTint="#FFFFFF"
                android:drawablePadding="6dp" />

            <!-- Clear Completed Pill -->
            <TextView
                android:id="@+id/btn_tv_clear_completed"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_tv_download_action_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Clear Queue"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@font/google_sans"
                android:nextFocusLeft="@id/btn_tv_resume_all"
                android:nextFocusUp="@id/download_appbar"
                android:nextFocusRight="@id/download_stream_button_tv"
                android:nextFocusDown="@id/download_list"
                app:drawableStartCompat="@drawable/ic_baseline_delete_outline_24"
                app:drawableTint="#FFFFFF"
                android:drawablePadding="6dp" />

            <!-- Stream URL Pill -->
            <ImageView
                android:id="@+id/download_stream_button_tv"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_tv_download_action_pill"
                android:clickable="true"
                android:contentDescription="@string/stream"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_network_stream"
                android:nextFocusLeft="@id/btn_tv_clear_completed"
                android:nextFocusUp="@id/download_appbar"
                android:nextFocusDown="@id/download_list"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- ==================================================== -->
        <!-- CONTENT GRID / LOADING / EMPTY STATE CONTAINER       -->
        <!-- ==================================================== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Loading Shimmer Placeholder -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/download_loading"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:shimmer_auto_start="true"
                app:shimmer_base_alpha="0.2"
                app:shimmer_duration="@integer/loading_time"
                tools:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include layout="@layout/loading_downloads" />
                    <include layout="@layout/loading_downloads" />
                    <include layout="@layout/loading_downloads" />
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

            <!-- 5-Column TV Grid RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/download_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="56dp"
                android:descendantFocusability="afterDescendants"
                android:nextFocusUp="@id/btn_tv_pause_all"
                tools:listitem="@layout/item_tv_download_header" />

            <!-- Empty State Card -->
            <LinearLayout
                android:id="@+id/tv_empty_downloads_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_tv_info_card_glass"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="40dp"
                android:paddingTop="28dp"
                android:paddingEnd="40dp"
                android:paddingBottom="28dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:src="@drawable/netflix_download"
                    app:tint="#6366F1" />

                <TextView
                    android:id="@+id/text_no_downloads"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/google_sans"
                    android:text="@string/downloads_empty"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Movies and TV shows you download will appear here for offline viewing."
                    android:textColor="#9BA0A4"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- ======================================================== -->
    <!-- HIDDEN MOBILE STUBS TO SATISFY VIEW BINDING              -->
    <!-- ======================================================== -->
    <LinearLayout
        android:id="@+id/steam_imageview_holder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/open_local_video_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/download_stream_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
