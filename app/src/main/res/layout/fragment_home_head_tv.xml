<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="0dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <View
        android:id="@+id/home_none_padding"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <!-- Fullscreen Cinematic Hero Billboard Container -->
    <FrameLayout
        android:id="@+id/home_hero_container"
        android:layout_width="match_parent"
        android:layout_height="540dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:background="@android:color/transparent">

        <!-- Fullscreen Background Carousel ViewPager2 -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/home_preview_viewpager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:descendantFocusability="blocksDescendants"
            android:orientation="horizontal" />


        <!-- Top-Left Brand Container: Logo + Provider Pill (Stuck to top of carousel) -->
        <LinearLayout
            android:id="@+id/home_tv_brand_holder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="44dp"
            android:layout_marginTop="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="4dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:elevation="20dp">

            <!-- App Logo (Transparent Pure White Emblem) -->
            <ImageView
                android:id="@+id/tv_app_logo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/splash_logo_white"
                android:scaleType="fitCenter" />

            <!-- Glassmorphic Provider Selector Pill -->
            <TextView
                android:id="@+id/home_change_api"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="6dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_tv_provider_pill"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Provider ▾"
                android:textColor="@color/color_tv_provider_pill_text"
                android:textSize="13sp"
                android:fontFamily="@font/google_sans"
                android:textStyle="bold"
                android:focusable="true"
                android:clickable="true"
                android:tag="@string/tv_no_focus_tag"
                android:nextFocusLeft="@id/tv_app_logo"
                android:nextFocusRight="@id/home_plugin_search_btn"
                android:nextFocusDown="@id/home_preview_play" />

            <!-- Glassmorphic Plugin Search Button -->
            <ImageView
                android:id="@+id/home_plugin_search_btn"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="6dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_tv_provider_pill"
                android:scaleType="centerInside"
                android:src="@drawable/search_icon"
                app:tint="@color/color_tv_provider_pill_text"
                android:padding="9dp"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="@string/search"
                android:tag="@string/tv_no_focus_tag"
                android:nextFocusLeft="@id/home_change_api"
                android:nextFocusRight="@id/tv_nav_home"
                android:nextFocusDown="@id/home_preview_play" />
        </LinearLayout>

        <!-- Lower-Left Hero Content Overlay -->
        <LinearLayout
            android:id="@+id/home_preview_viewpager_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_gravity="bottom|start"
            android:orientation="vertical"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:paddingBottom="36dp">

            <!-- Title Logo Image (if provided by API) -->
            <ImageView
                android:id="@+id/home_background_poster_watermark_badge_holder"
                android:layout_width="wrap_content"
                android:layout_height="72dp"
                android:contentDescription="@null"
                android:maxWidth="280dp"
                android:maxHeight="72dp"
                android:scaleType="fitStart"
                android:adjustViewBounds="true"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Large Title Typography (Headline) -->
            <TextView
                android:id="@+id/home_preview_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:textStyle="bold"
                android:fontFamily="@font/google_sans"
                android:letterSpacing="0.02"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="6"
                tools:text="THE WHISPER MAN" />

            <!-- Metadata Row: Rating, Year, Genre -->
            <LinearLayout
                android:id="@+id/home_preview_meta_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Rating badge with star -->
                <TextView
                    android:id="@+id/home_preview_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:textColor="#FFD700"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/google_sans"
                    app:drawableStartCompat="@drawable/ic_baseline_star_24"
                    app:drawableTint="#FFD700"
                    android:drawablePadding="5dp"
                    tools:text="6.8/10" />

                <!-- Separator Dot -->
                <TextView
                    android:id="@+id/home_meta_dot1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp"
                    android:text="•"
                    android:textColor="#80FFFFFF"
                    android:textSize="14sp" />

                <!-- Release Year with calendar icon -->
                <TextView
                    android:id="@+id/home_preview_year"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:textColor="#E0E0E0"
                    android:textSize="14sp"
                    android:fontFamily="@font/google_sans"
                    app:drawableStartCompat="@drawable/ic_baseline_calendar_today_24"
                    app:drawableTint="#B3FFFFFF"
                    android:drawablePadding="5dp"
                    tools:text="2026" />

                <!-- Separator Dot -->
                <TextView
                    android:id="@+id/home_meta_dot2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp"
                    android:text="•"
                    android:textColor="#80FFFFFF"
                    android:textSize="14sp" />

                <!-- Duration or Genres -->
                <TextView
                    android:id="@+id/home_preview_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:textColor="#E0E0E0"
                    android:textSize="14sp"
                    android:fontFamily="@font/google_sans"
                    tools:text="Crime" />

            </LinearLayout>

            <!-- Synopsis / Description (2-3 clean lines) -->
            <TextView
                android:id="@+id/home_preview_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxWidth="560dp"
                android:ellipsize="end"
                android:maxLines="3"
                android:lineSpacingExtra="4dp"
                android:textColor="#D9FFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/google_sans"
                android:shadowColor="#B0000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                tools:text="When his young son vanishes, a widower enlists help from his estranged father, a retired detective who put away the serial killer now linked to the case." />

            <!-- Cast summary (optional line) -->
            <TextView
                android:id="@+id/home_preview_cast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#9E9E9E"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Cast: Actor One, Actor Two" />

            <!-- Tags chip group (optional) -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/home_preview_tags"
                style="@style/ChipParent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

            <!-- Action Buttons and Carousel Indicator Row -->
            <RelativeLayout
                android:id="@+id/home_preview_action_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical">

                <!-- Left Action Buttons: Play + Split Pill (Bookmark & Info) -->
                <LinearLayout
                    android:id="@+id/home_preview_action_buttons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:gravity="center_vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="4dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:orientation="horizontal">

                    <!-- Primary Action: Solid White Capsule Play Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/home_preview_play"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="6dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp"
                        android:background="@drawable/bg_pill_white"
                        app:backgroundTint="@null"
                        android:foreground="@null"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:stateListAnimator="@null"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:text="@string/home_play"
                        android:textColor="#0B0C10"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/google_sans"
                        app:cornerRadius="22dp"
                        app:icon="@drawable/ic_baseline_play_arrow_24"
                        app:iconTint="#0B0C10"
                        app:iconGravity="textStart"
                        app:iconSize="20dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:tag="@string/tv_no_focus_tag"
                        android:nextFocusUp="@id/home_change_api"
                        android:nextFocusRight="@id/home_preview_bookmark" />

                    <!-- Secondary Action: Frosted Glass Split Pill [ + | ⓘ ] -->
                    <LinearLayout
                        android:id="@+id/home_preview_action_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_glass_split_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <!-- Bookmark / Watchlist (+) -->
                        <ImageView
                            android:id="@+id/home_preview_bookmark"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_glass_pill_button"
                            android:contentDescription="@string/action_add_to_bookmarks"
                            android:padding="7dp"
                            android:src="@drawable/ic_baseline_add_24"
                            app:tint="@color/white"
                            android:focusable="true"
                            android:clickable="true"
                            android:tag="@string/tv_no_focus_tag"
                            android:nextFocusLeft="@id/home_preview_play"
                            android:nextFocusRight="@id/home_preview_info"
                            android:nextFocusUp="@id/home_change_api" />

                        <!-- Thin Divider -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:background="#33FFFFFF" />

                        <!-- Info / Details (ⓘ) -->
                        <ImageView
                            android:id="@+id/home_preview_info"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_glass_pill_button"
                            android:contentDescription="@string/home_more_info"
                            android:padding="7dp"
                            android:src="@drawable/ic_outline_info_24"
                            app:tint="@color/white"
                            android:focusable="true"
                            android:clickable="true"
                            android:tag="@string/tv_no_focus_tag"
                            android:nextFocusLeft="@id/home_preview_bookmark"
                            android:nextFocusUp="@id/tv_nav_home" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Right Side: Carousel Page Indicator Dots [ • • • • • ▬ ] -->
                <LinearLayout
                    android:id="@+id/home_carousel_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />

            </RelativeLayout>

        </LinearLayout>

        <!-- Invisible compatibility button for legacy click listeners -->
        <View
            android:id="@+id/home_preview_info_btt"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Continue Watching Rail -->
    <LinearLayout
        android:id="@+id/home_watch_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/home_watch_parent_item_title"
            style="@style/WatchHeaderText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="0dp"
            android:background="?android:attr/selectableItemBackground"
            android:padding="12dp"
            android:text="@string/continue_watching"
            app:drawableTint="?attr/white" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/home_watch_child_recyclerview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:nextFocusUp="@id/home_preview_play"
            android:nextFocusDown="@id/home_type_holder"
            android:orientation="horizontal"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:paddingTop="10dp"
            android:paddingBottom="14dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/home_result_grid" />

    </LinearLayout>

    <!-- Bookmarked Rail -->
    <LinearLayout
        android:id="@+id/home_bookmarked_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <FrameLayout
            android:id="@+id/home_bookmark_parent_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground">

            <HorizontalScrollView
                android:id="@+id/horizontal_scroll_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fadingEdge="horizontal"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:paddingStart="40dp"
                android:paddingTop="5dp"
                android:paddingEnd="40dp"
                android:paddingBottom="5dp"
                android:requiresFadingEdge="horizontal">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/home_type_holder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:descendantFocusability="afterDescendants"
                    android:nextFocusLeft="@id/tv_nav_home"
                    android:nextFocusUp="@id/home_watch_child_recyclerview">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/home_type_watching_btt"
                        style="@style/ChipFilledSemiTransparent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/type_watching" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/home_type_completed_btt"
                        style="@style/ChipFilledSemiTransparent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/type_completed" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/home_type_on_hold_btt"
                        style="@style/ChipFilledSemiTransparent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/type_on_hold" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/home_plan_to_watch_btt"
                        style="@style/ChipFilledSemiTransparent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/type_plan_to_watch" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/home_type_dropped_btt"
                        style="@style/ChipFilledSemiTransparent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/type_dropped" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/home_bookmark_parent_item_more_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="40dp"
                android:background="?android:attr/selectableItemBackground"
                android:padding="12dp"
                android:text="@string/home_more_info"
                android:textColor="?attr/white"
                android:textSize="14sp"
                android:visibility="gone" />

        </FrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/home_bookmarked_child_recyclerview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:nextFocusUp="@id/home_type_holder"
            android:orientation="horizontal"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:paddingTop="10dp"
            android:paddingBottom="14dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/home_result_grid" />

    </LinearLayout>

</LinearLayout>