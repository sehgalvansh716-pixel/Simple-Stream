            <TextView
                android:id="@+id/text_quality"
                style="@style/TypeButton" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_is_dub"
                    style="@style/DubButton"
                    android:layout_gravity="end" />

                <TextView
                    android:id="@+id/text_is_sub"
                    style="@style/SubButton"
                    android:layout_gravity="end" />

                <TextView
                    android:id="@+id/text_rating"
                    style="@style/RatingButton"
                    android:layout_gravity="end"
                    tools:text="7.7" />

                <TextView
                    android:id="@+id/text_flag"
                    style="@style/SearchBox"
                    android:layout_gravity="end"
                    android:background="@color/transparent"
                    android:textSize="20sp"
                    android:visibility="gone"
                    tools:text="🇸🇪"
                    tools:visibility="visible" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingBottom="3dp">
                <TextView
                    android:id="@+id/episode_text"
                    android:layout_width="wrap_content"
                    style="@style/EpisodeTextButton"
                    android:layout_gravity="center"/>
            </LinearLayout>

            <!-- Focused Dimmer Overlay for TV -->
            <View
                android:id="@+id/card_focus_dimmer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#73000000"
                android:visibility="gone" />

            <!-- Focused Center Info Container for TV (Play Icon + Title + Year & Rating) -->
            <LinearLayout
                android:id="@+id/card_focus_info"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:visibility="gone">

                <!-- Centered Circular White Play Button with Black Arrow -->
                <ImageView
                    android:id="@+id/card_play_icon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_tv_card_play_circle"
                    android:paddingStart="13dp"
                    android:paddingEnd="11dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_tv_play_black"
                    android:elevation="4dp"
                    tools:ignore="ContentDescription" />

                <!-- Title -->
                <TextView
                    android:id="@+id/card_focus_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/google_sans"
                    android:shadowColor="#99000000"
                    android:shadowRadius="3"
                    android:shadowDy="1"
                    tools:text="Mayday" />

                <!-- Year and Rating (e.g. "2026 ★ 8.0") -->
                <TextView
                    android:id="@+id/card_focus_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/google_sans"
                    android:shadowColor="#99000000"
                    android:shadowRadius="3"
                    android:shadowDy="1"
                    tools:text="2026 ★ 8.0" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/imageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:minLines="1"
            android:paddingStart="4dp"
            android:paddingTop="6dp"
            android:paddingEnd="4dp"
            android:paddingBottom="1dp"
            android:textColor="@color/white"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:fontFamily="@font/google_sans"
            tools:text="The Perfect Run" />

        <TextView
            android:id="@+id/imageSubText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp"
            android:textColor="#8A99AD"
            android:textSize="11sp"
            android:fontFamily="@font/google_sans"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="★ 7.7  2026" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
