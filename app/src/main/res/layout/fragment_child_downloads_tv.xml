<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/download_child_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07090D"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".ui.download.DownloadChildFragment">

    <!-- Ambient Video TextureView -->
    <TextureView
        android:id="@+id/tv_child_downloads_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/tv_child_downloads_video_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_tv_search_video_overlay" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80070A0F" />

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="44dp"
        android:paddingEnd="44dp"
        android:paddingTop="22dp">

        <!-- TV Top Bar Header: Back, Logo, Series Title & Selection Toggle -->
        <LinearLayout
            android:id="@+id/download_child_tv_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="16dp">

            <!-- Circular Glass Back Button -->
            <ImageView
                android:id="@+id/download_child_tv_back"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_tv_circular_glass_btn"
                android:clickable="true"
                android:contentDescription="@string/go_back"
                android:defaultFocusHighlightEnabled="false"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_baseline_arrow_back_24"
                android:nextFocusDown="@id/download_child_list"
                app:tint="#FFFFFF" />

            <!-- App Logo Emblem -->
            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="14dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/splash_logo_white" />

            <!-- MaterialToolbar for Series Title and ViewBinding satisfaction -->
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/download_child_toolbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                app:titleTextColor="#FFFFFF"
                tools:title="Game of Thrones - Downloads" />
        </LinearLayout>

        <!-- Multi-Delete Action Bar (Visible when items are selected) -->
        <LinearLayout
            android:id="@+id/download_delete_appbar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_tv_info_card_glass"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnCancel"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_tv_circular_glass_btn"
                android:contentDescription="@string/cancel"
                android:src="@drawable/ic_baseline_close_24"
                android:padding="6dp"
                android:focusable="true"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/selectItemsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="@string/downloads_delete_select"
                android:textColor="#E9EAEE"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnDelete"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_tv_danger_action_pill"
                android:text="@string/delete"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:focusable="true" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnToggleAll"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_tv_download_action_pill"
                android:text="@string/select_all"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:focusable="true" />
        </LinearLayout>

        <!-- Episode Cards Grid (16:9 Landscape Cards) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/download_child_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="56dp"
            android:descendantFocusability="afterDescendants"
            tools:listitem="@layout/item_tv_download_child" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
