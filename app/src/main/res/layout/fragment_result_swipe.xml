<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080B10">

    <!-- 1. Fullscreen trailer holder -->
    <FrameLayout
        android:id="@+id/result_fullscreen_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Fullscreen Extended Atmospheric Backdrop Layer (Matches Home Carousel) -->
    <FrameLayout
        android:id="@+id/result_backdrop_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/result_backdrop_image_a"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/result_backdrop_image_b"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:alpha="0"
            tools:ignore="ContentDescription" />

        <!-- Extended Ambient Gradient Overlay into Obsidian Canvas -->
        <View
            android:id="@+id/result_backdrop_gradient"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_mobile_home_extended_gradient" />
    </FrameLayout>

    <!-- 2. Main content canvas with overlapping panels -->
    <FrameLayout
        android:id="@+id/result_main_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.discord.panels.OverlappingPanelsLayout
            android:id="@+id/result_overlapping_panels"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Set layout_gravity on the start panel to "start" -->
            <FrameLayout
                android:id="@+id/start_panel"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:visibility="gone">

                <include
                    android:id="@+id/result_sync"
                    layout="@layout/result_sync" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/center_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center">

                <include
                    android:id="@+id/fragment_result"
                    layout="@layout/fragment_result" />

            </FrameLayout>

            <!-- End panel hidden; recommendations are shown inline on the main page -->
            <FrameLayout
                android:id="@+id/end_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="#080B10"
                android:elevation="12dp"
                android:visibility="gone">

                <include
                    android:id="@+id/result_recommendations"
                    layout="@layout/result_recommendations" />
            </FrameLayout>
        </com.discord.panels.OverlappingPanelsLayout>

        <!-- Bottom Controls & Mini Controller -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/result_bookmark_fab"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="90dp"
                android:backgroundTint="#CC0B0E14"
                android:fontFamily="@font/google_sans"
                android:textAllCaps="false"
                android:textColor="#E9EAEE"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="24dp"
                app:elevation="8dp"
                app:icon="@drawable/ic_baseline_bookmark_24"
                app:iconTint="#E9EAEE"
                app:strokeColor="#38FFFFFF"
                app:strokeWidth="1.2dp"
                tools:ignore="ContentDescription"
                tools:visibility="visible" />

            <fragment
                android:id="@+id/cast_mini_controller"
                class="com.lagradost.cloudstream3.ui.MyMiniControllerFragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:castControlButtons="@array/cast_mini_controller_control_buttons"
                app:customCastBackgroundColor="?attr/primaryBlackBackground"
                tools:ignore="FragmentTagUsage" />
        </LinearLayout>
    </FrameLayout>

    <!-- 3. Floating Liquid Glass Top Bar -->
    <FrameLayout
        android:id="@+id/result_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_mobile_hero_top_gradient"
        android:elevation="20dp"
        android:paddingStart="16dp"
        android:paddingTop="28dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:translationZ="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/result_back"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center_vertical|start"
                android:background="@drawable/bg_tv_circular_glass_btn"
                android:clickable="true"
                android:contentDescription="@string/go_back"
                android:focusable="true"
                android:nextFocusRight="@id/result_mini_sync"
                android:padding="8dp"
                android:src="@drawable/ic_baseline_arrow_back_24"
                app:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/result_mini_sync"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tv_circular_glass_btn"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusRight="@id/result_subscribe"
                android:padding="8dp"
                android:src="@drawable/bookmark_star_24px"
                android:visibility="gone"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/media_route_button_holder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:animateLayoutChanges="true"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <androidx.mediarouter.app.MediaRouteButton
                android:id="@+id/media_route_button"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_tv_circular_glass_btn"
                android:mediaRouteTypes="user"
                android:padding="6dp"
                android:visibility="gone"
                app:mediaRouteButtonTint="#E9EAEE" />

            <ImageView
                android:id="@+id/result_subscribe"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_tv_circular_glass_btn"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusLeft="@id/result_add_sync"
                android:nextFocusRight="@id/result_favorite"
                android:nextFocusUp="@id/result_back"
                android:nextFocusDown="@id/result_description"
                android:padding="8dp"
                android:src="@drawable/baseline_notifications_none_24"
                android:tooltipText="@string/subscribe_tooltip"
                android:visibility="gone"
                app:tint="#E9EAEE"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/result_favorite"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_tv_circular_glass_btn"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusLeft="@id/result_subscribe"
                android:nextFocusRight="@id/result_share"
                android:nextFocusUp="@id/result_back"
                android:nextFocusDown="@id/result_description"
                android:padding="8dp"
                android:src="@drawable/ic_baseline_favorite_border_24"
                android:tooltipText="@string/action_add_to_favorites"
                app:tint="#E9EAEE" />

            <ImageView
                android:id="@+id/result_share"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_tv_circular_glass_btn"
                android:clickable="true"
                android:contentDescription="@string/result_share"
                android:focusable="true"
                android:nextFocusLeft="@id/result_favorite"
                android:nextFocusRight="@id/result_open_in_browser"
                android:nextFocusUp="@id/result_back"
                android:nextFocusDown="@id/result_description"
                android:padding="8dp"
                android:src="@drawable/ic_outline_share_24"
                android:tooltipText="@string/result_share"
                app:tint="#E9EAEE" />

            <ImageView
                android:id="@+id/result_open_in_browser"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_tv_circular_glass_btn"
                android:clickable="true"
                android:contentDescription="@string/result_open_in_browser"
                android:focusable="true"
                android:nextFocusLeft="@id/result_share"
                android:nextFocusRight="@id/result_search"
                android:nextFocusUp="@id/result_back"
                android:nextFocusDown="@id/result_description"
                android:padding="8dp"
                android:src="@drawable/ic_baseline_public_24"
                android:tooltipText="@string/result_open_in_browser"
                app:tint="#E9EAEE" />

            <ImageView
                android:id="@+id/result_search"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_tv_circular_glass_btn"
                android:clickable="true"
                android:contentDescription="@string/result_open_in_browser"
                android:focusable="true"
                android:nextFocusLeft="@id/result_open_in_browser"
                android:nextFocusRight="@id/result_recommendations_btt"
                android:nextFocusUp="@id/result_back"
                android:nextFocusDown="@id/result_description"
                android:padding="8dp"
                android:src="@drawable/search_icon"
                android:tooltipText="@string/result_search_tooltip"
                app:tint="#E9EAEE" />

            <ImageView
                android:id="@+id/result_recommendations_btt"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center_vertical|end"
                android:background="@drawable/bg_tv_circular_glass_btn"
                android:clickable="true"
                android:contentDescription="@string/result_open_in_browser"
                android:focusable="true"
                android:nextFocusLeft="@id/result_search"
                android:nextFocusUp="@id/result_back"
                android:nextFocusDown="@id/result_description"
                android:padding="8dp"
                android:src="@drawable/baseline_list_alt_24"
                android:tooltipText="@string/recommendations_tooltip"
                android:visibility="gone"
                app:tint="#E9EAEE" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
