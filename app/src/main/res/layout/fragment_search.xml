<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/searchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF07090D"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".ui.search.SearchFragment">

    <!-- 60fps Hardware-Accelerated Ambient Video / 7-Theme WebGL Shader -->
    <TextureView
        android:id="@+id/tv_search_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Atmospheric Dark Vignette Overlay -->
    <View
        android:id="@+id/tv_search_gradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_mobile_search_video_overlay" />

    <!-- Main Container Layout -->
    <LinearLayout
        android:id="@+id/search_main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="true"
        android:clipToPadding="true">

        <!-- Top Header Group (Padded below status bar via WindowInsets) -->
        <LinearLayout
            android:id="@+id/search_header_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="36dp"
            android:paddingBottom="4dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- True-Liquid-Glass Search Bar Capsule with Real Optical Blur -->
            <eightbitlab.com.blurview.BlurView
                android:id="@+id/search_bar_blur"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="18dp"
                app:blurOverlayColor="@android:color/transparent">

                <LinearLayout
                    android:id="@+id/tv_search_bar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_mobile_search_pill_glass"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:id="@+id/tv_search_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/search_icon"
                        app:tint="#FFFFFF"
                        android:contentDescription="@string/search" />

                    <androidx.appcompat.widget.SearchView
                        android:id="@+id/main_search"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:iconifiedByDefault="false"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        app:iconifiedByDefault="false"
                        app:queryBackground="@android:color/transparent"
                        app:queryHint="@string/search_hint"
                        app:searchIcon="@null"
                        app:closeIcon="@drawable/ic_baseline_clear_24"
                        tools:ignore="RtlSymmetry">

                        <androidx.core.widget.ContentLoadingProgressBar
                            android:id="@+id/search_loading_bar"
                            style="@style/Widget.AppCompat.ProgressBar"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:foregroundTint="@color/white"
                            android:progressTint="@color/white" />
                    </androidx.appcompat.widget.SearchView>

                    <!-- Voice Search Button -->
                    <ImageView
                        android:id="@+id/voice_search"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/search"
                        android:padding="5dp"
                        android:src="@drawable/ic_mic"
                        app:tint="#FFFFFF" />

                    <!-- Search Filter / Provider Button -->
                    <ImageView
                        android:id="@+id/search_filter"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="4dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/change_providers_img_des"
                        android:padding="5dp"
                        android:src="@drawable/ic_baseline_tune_24"
                        app:tint="#FFFFFF" />
                </LinearLayout>
            </eightbitlab.com.blurview.BlurView>

            <!-- Recent Searches Horizontal Chip Row -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/search_history_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="4dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:descendantFocusability="afterDescendants"
                tools:listitem="@layout/search_history_item" />

            <!-- Hidden Filter Chips Stub for ViewBinding Parity -->
            <include
                android:id="@+id/tvtypes_chips_scroll"
                layout="@layout/tvtypes_chips_scroll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Content Group (Section Title + Recycler Grid) with Clean Viewport Clipping -->
        <LinearLayout
            android:id="@+id/search_content_group"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clipChildren="true"
            android:clipToPadding="true">

            <!-- Section Title: "Trending Today" / "Search Results" -->
            <TextView
                android:id="@+id/tv_search_section_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/google_sans"
                android:text="@string/tv_trending_today"
                android:textColor="#E9EAEE"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Empty Results Message -->
            <TextView
                android:id="@+id/tv_search_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="40dp"
                android:fontFamily="@font/google_sans"
                android:text="@string/tv_no_results_found"
                android:textColor="#8A99AD"
                android:textSize="15sp"
                android:visibility="gone" />

            <!-- Search Results 3-Column Recycler Grid -->
            <com.lagradost.cloudstream3.ui.AutofitRecyclerView
                android:id="@+id/search_autofit_results"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="true"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="12dp"
                android:paddingBottom="96dp"
                app:spanCount="3"
                tools:listitem="@layout/search_result_grid_expanded" />
        </LinearLayout>
    </LinearLayout>

    <!-- Compatibility Stubs (Preserving ViewBinding compatibility with TV layout) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_master_recycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_suggestions_recycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</FrameLayout>