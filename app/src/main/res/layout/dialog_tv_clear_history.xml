<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="480dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/bg_tv_dialog_glass"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="26dp"
    android:paddingEnd="28dp"
    android:paddingBottom="24dp"
    android:elevation="24dp">

    <!-- Header Section with Danger Icon Badge and Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Danger Icon Badge -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_tv_danger_badge">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_baseline_delete_outline_24"
                app:tint="#FF6B6B"
                tools:ignore="ContentDescription" />
        </FrameLayout>

        <!-- Title & Subtitle Container -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dialog_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans"
                android:text="@string/clear_history"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dialog_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/google_sans"
                android:text="This will permanently delete your search history. Are you sure?"
                android:textColor="#8A99AD"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Cancel Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/bg_tv_settings_action_pill"
            app:backgroundTint="@null"
            android:fontFamily="@font/google_sans"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:gravity="center"
            android:singleLine="true"
            android:maxLines="1"
            android:textAllCaps="false"
            app:textAllCaps="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/cancel"
            android:textColor="@color/color_tv_settings_action_pill_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusRight="@+id/btn_clear" />

        <!-- Clear / Delete Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_clear"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_tv_danger_action_pill"
            app:backgroundTint="@null"
            android:fontFamily="@font/google_sans"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:gravity="center"
            android:singleLine="true"
            android:maxLines="1"
            android:textAllCaps="false"
            app:textAllCaps="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/sort_clear"
            android:textColor="@color/color_tv_danger_pill_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusLeft="@+id/btn_cancel" />
    </LinearLayout>

</LinearLayout>
