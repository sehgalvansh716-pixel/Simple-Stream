<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/searchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF07090D"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".ui.search.SearchFragment">

    <!-- 60fps Ambient Green Silk Flow Background Video -->
    <TextureView
        android:id="@+id/tv_search_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Atmospheric Dark Gradient & Vignette Scrim Overlay -->
    <View
        android:id="@+id/tv_search_gradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_tv_search_video_overlay" />

    <!-- Top-Left Back Button & SimpleStream Brand Logo -->
    <LinearLayout
        android:id="@+id/tv_search_top_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|top"
        android:layout_marginStart="36dp"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:elevation="6dp">

        <ImageView
            android:id="@+id/tv_search_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/go_back"
            android:focusable="true"
            android:clickable="true"
            android:padding="6dp"
            android:src="@drawable/ic_baseline_arrow_back_24"
            android:nextFocusRight="@+id/main_search"
            android:nextFocusDown="@+id/main_search"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/tv_search_logo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/splash_logo_white" />
    </LinearLayout>

    <!-- Main Content Area -->
    <LinearLayout
        android:id="@+id/tv_search_main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Search Header Group (Anchored at Top) -->
        <LinearLayout
            android:id="@+id/tv_search_header_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:elevation="4dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Headline: "Let's find a movie night pick" -->
            <TextView
                android:id="@+id/tv_search_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="60dp"
                android:fontFamily="@font/google_sans"
                android:text="@string/tv_movie_night_pick"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Cinejoy-Inspired Glassmorphic Search Bar Capsule -->
            <LinearLayout
                android:id="@+id/tv_search_bar"
                android:layout_width="620dp"
                android:layout_height="46dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_tv_search_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="12dp">

                <!-- Search Magnifying Icon -->
                <ImageView
                    android:id="@+id/tv_search_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/search_icon"
                    app:tint="#80FFFFFF"
                    android:contentDescription="@string/search" />

                <!-- Embedded SearchView with Query Text and Loading Indicator -->
                <androidx.appcompat.widget.SearchView
                    android:id="@+id/main_search"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:iconifiedByDefault="false"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    app:iconifiedByDefault="false"
                    app:queryBackground="@color/transparent"
                    app:queryHint="@string/tv_search_hint"
                    app:searchIcon="@null"
                    app:closeIcon="@drawable/ic_baseline_clear_24"
                    android:nextFocusUp="@+id/tv_nav_search"
                    android:nextFocusDown="@+id/search_history_recycler"
                    android:nextFocusRight="@+id/voice_search"
                    tools:ignore="RtlSymmetry">

                    <androidx.core.widget.ContentLoadingProgressBar
                        android:id="@+id/search_loading_bar"
                        style="@style/Widget.AppCompat.ProgressBar"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:foregroundTint="@color/white"
                        android:progressTint="@color/white" />
                </androidx.appcompat.widget.SearchView>

                <!-- Voice Search Button -->
                <ImageView
                    android:id="@+id/voice_search"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_tv_search_icon_btn"
                    android:contentDescription="@string/search"
                    android:focusable="true"
                    android:clickable="true"
                    android:padding="5dp"
                    android:src="@drawable/ic_mic"
                    android:nextFocusLeft="@+id/main_search"
                    android:nextFocusRight="@+id/search_filter"
                    android:nextFocusUp="@+id/tv_nav_search"
                    android:nextFocusDown="@+id/search_history_recycler"
                    app:tint="@color/color_tv_search_icon_tint" />

                <!-- Filter / Providers Button -->
                <ImageView
                    android:id="@+id/search_filter"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_tv_search_icon_btn"
                    android:contentDescription="@string/change_providers_img_des"
                    android:focusable="true"
                    android:clickable="true"
                    android:padding="5dp"
                    android:src="@drawable/ic_baseline_tune_24"
                    android:nextFocusLeft="@+id/voice_search"
                    android:nextFocusUp="@+id/tv_nav_search"
                    android:nextFocusDown="@+id/search_history_recycler"
                    app:tint="@color/color_tv_search_icon_tint" />
            </LinearLayout>

            <!-- Recent Searches Horizontal Chip Row -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/search_history_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="4dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="36dp"
                android:paddingEnd="36dp"
                android:descendantFocusability="afterDescendants"
                android:nextFocusUp="@+id/main_search"
                android:nextFocusDown="@+id/search_autofit_results"
                tools:listitem="@layout/search_history_item_tv" />

            <!-- Filter Chips (Included for ViewBinding compatibility) -->
            <include
                android:id="@+id/tvtypes_chips_scroll"
                layout="@layout/tvtypes_chips_scroll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Content Group (Section Title + Recycler Grid with Viewport Clipping) -->
        <LinearLayout
            android:id="@+id/tv_search_content_group"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clipChildren="true"
            android:clipToPadding="true">

            <!-- Section Title: "Trending Today" / Query Results -->
            <TextView
                android:id="@+id/tv_search_section_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/google_sans"
                android:text="@string/tv_trending_today"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Empty Results Message -->
            <TextView
                android:id="@+id/tv_search_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="40dp"
                android:fontFamily="@font/google_sans"
                android:text="@string/tv_no_results_found"
                android:textColor="#8A99AD"
                android:textSize="16sp"
                android:visibility="gone" />

            <!-- 5-Column Search Results Recycler Grid -->
            <com.lagradost.cloudstream3.ui.AutofitRecyclerView
                android:id="@+id/search_autofit_results"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="true"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:paddingStart="36dp"
                android:paddingEnd="36dp"
                android:paddingTop="28dp"
                android:paddingBottom="64dp"
                android:nextFocusUp="@+id/main_search"
                tools:listitem="@layout/search_result_grid" />
        </LinearLayout>
    </LinearLayout>

    <!-- Compatibility Stubs (Preserving ViewBinding compatibility with FragmentSearchBinding) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_master_recycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_suggestions_recycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/search_bar_blur"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/search_content_group"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/search_header_group"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/search_main_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</FrameLayout>