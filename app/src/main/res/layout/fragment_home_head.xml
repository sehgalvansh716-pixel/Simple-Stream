<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <View
        android:id="@+id/home_none_padding"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <FrameLayout
        android:id="@+id/home_hero_container"
        android:layout_width="match_parent"
        android:layout_height="750dp"
        android:background="@android:color/transparent">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/home_preview_viewpager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal" />

        <!-- Compatibility Top Header Bar (Real pinned header is in fragment_home.xml) -->
        <LinearLayout
            android:id="@+id/home_padding"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">

            <!-- App Logo (Transparent Pure White Emblem) -->
            <ImageView
                android:id="@+id/home_mobile_logo"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/splash_logo_white"
                android:scaleType="fitCenter" />

            <!-- Glassmorphic Provider Selector Pill -->
            <TextView
                android:id="@+id/home_change_api"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_tv_provider_pill"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Provider ▾"
                android:textColor="#F3F4F6"
                android:textSize="12.5sp"
                android:fontFamily="@font/google_sans"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <!-- Glassmorphic Search Button -->
            <ImageView
                android:id="@+id/home_plugin_search_btn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_tv_provider_pill"
                android:scaleType="centerInside"
                android:src="@drawable/search_icon"
                app:tint="#F3F4F6"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/search" />

            <!-- Hidden compatibility SearchView for ViewBinding -->
            <androidx.appcompat.widget.SearchView
                android:id="@+id/home_search"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:visibility="gone" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Profile Avatar (Right) -->
            <LinearLayout
                android:id="@+id/home_head_profile_padding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:id="@+id/home_head_profile_card"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:background="@color/transparent"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/transparent">

                    <ImageView
                        android:id="@+id/home_head_profile_pic"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/account"
                        android:scaleType="centerCrop"
                        tools:src="@drawable/profile_bg_orange" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Action & Carousel Cluster -->
        <LinearLayout
            android:id="@+id/home_preview_viewpager_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <!-- Title Logo Image (if provided by API) -->
            <ImageView
                android:id="@+id/home_background_poster_watermark_badge_holder"
                android:layout_width="wrap_content"
                android:layout_height="64dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@null"
                android:maxWidth="260dp"
                android:maxHeight="64dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Large Title Typography (Headline) -->
            <TextView
                android:id="@+id/home_preview_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="@font/google_sans"
                android:letterSpacing="0.02"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="6"
                tools:text="THE RUNNER" />

            <!-- Metadata Row: Rating, Year, Genre -->
            <LinearLayout
                android:id="@+id/home_preview_meta_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_gravity="center_horizontal"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Rating badge with star -->
                <TextView
                    android:id="@+id/home_preview_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:textColor="#FFD700"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/google_sans"
                    app:drawableStartCompat="@drawable/ic_baseline_star_24"
                    app:drawableTint="#FFD700"
                    android:drawablePadding="4dp"
                    tools:text="6.6/10" />

                <!-- Separator Dot -->
                <TextView
                    android:id="@+id/home_meta_dot1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="7dp"
                    android:text="•"
                    android:textColor="#80FFFFFF"
                    android:textSize="13sp" />

                <!-- Release Year with calendar icon -->
                <TextView
                    android:id="@+id/home_preview_year"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:textColor="#E0E0E0"
                    android:textSize="13sp"
                    android:fontFamily="@font/google_sans"
                    app:drawableStartCompat="@drawable/ic_baseline_calendar_today_24"
                    app:drawableTint="#B3FFFFFF"
                    android:drawablePadding="4dp"
                    tools:text="2026" />

                <!-- Separator Dot -->
                <TextView
                    android:id="@+id/home_meta_dot2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="7dp"
                    android:text="•"
                    android:textColor="#80FFFFFF"
                    android:textSize="13sp" />

                <!-- Genre -->
                <TextView
                    android:id="@+id/home_preview_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:textColor="#E0E0E0"
                    android:textSize="13sp"
                    android:fontFamily="@font/google_sans"
                    tools:text="Thriller" />

            </LinearLayout>

            <!-- Synopsis / Description (2 lines max) -->
            <TextView
                android:id="@+id/home_preview_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:ellipsize="end"
                android:maxLines="2"
                android:lineSpacingExtra="2dp"
                android:textColor="#D9FFFFFF"
                android:textSize="12.5sp"
                android:fontFamily="@font/google_sans"
                android:shadowColor="#B0000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:layout_marginTop="5dp"
                android:paddingHorizontal="12dp"
                tools:text="Maia Marten, a brilliant London lawyer, has her life shattered by a single call on her morning run: her son has been abducted." />

            <!-- Action Buttons Row: [ ▶ Play ]   [ + | ⓘ ] -->
            <LinearLayout
                android:id="@+id/home_preview_title_holder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Primary Action: Solid White Capsule Play Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/home_preview_play"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_pill_white"
                    app:backgroundTint="@null"
                    android:foreground="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:stateListAnimator="@null"
                    android:paddingStart="22dp"
                    android:paddingEnd="24dp"
                    android:text="@string/home_play"
                    android:textColor="#0B0C10"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/google_sans"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_baseline_play_arrow_24"
                    app:iconTint="#0B0C10"
                    app:iconGravity="textStart"
                    app:iconSize="20dp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Secondary Action: Frosted Glass Split Pill [ + | ⓘ ] with real BlurView -->
                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/home_preview_action_pill_blur"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_mobile_split_pill_glass">

                    <LinearLayout
                        android:id="@+id/home_preview_action_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <!-- Bookmark / Watchlist (+) -->
                        <ImageView
                            android:id="@+id/home_preview_bookmark"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/action_add_to_bookmarks"
                            android:padding="8dp"
                            android:src="@drawable/ic_baseline_add_24"
                            app:tint="@color/white"
                            android:clickable="true"
                            android:focusable="true" />

                        <!-- Thin Divider Line -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="18dp"
                            android:layout_marginHorizontal="2dp"
                            android:background="#33FFFFFF" />

                        <!-- Info / Details (ⓘ) -->
                        <ImageView
                            android:id="@+id/home_preview_info"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/home_more_info"
                            android:padding="8dp"
                            android:src="@drawable/ic_outline_info_24"
                            app:tint="@color/white"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>
                </eightbitlab.com.blurview.BlurView>

            </LinearLayout>

            <!-- Dynamic Carousel Indicator Dots (Hidden on mobile for clean cinematic look) -->
            <LinearLayout
                android:id="@+id/home_carousel_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_marginTop="10dp" />

        </LinearLayout>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/alternative_account_padding"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingHorizontal="0dp">

        <LinearLayout
            android:id="@+id/alternate_home_head_profile_padding"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:clickable="false"
            android:focusable="false"
            android:gravity="center"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:id="@+id/alternate_home_head_profile_card"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@color/transparent"
                app:cardCornerRadius="0dp">

                <ImageView
                    android:id="@+id/alternate_home_head_profile_pic"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:contentDescription="@string/account" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>


    <LinearLayout
        android:id="@+id/home_watch_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/home_watch_parent_item_title"
            style="@style/WatchHeaderText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="0dp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/home_more_info"
            android:padding="12dp"
            android:text="@string/continue_watching"
            app:drawableRightCompat="@drawable/ic_baseline_arrow_forward_24"
            app:drawableTint="?attr/white" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/home_watch_child_recyclerview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:orientation="horizontal"
            android:paddingHorizontal="5dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/home_result_grid" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/home_bookmarked_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <FrameLayout
            android:id="@+id/home_bookmark_parent_item_title"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="50dp"
                android:fadingEdge="horizontal"

                android:nextFocusLeft="@id/nav_rail_view"
                android:nextFocusUp="@id/home_watch_child_recyclerview"
                android:nextFocusForward="@id/home_bookmarked_child_recyclerview"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"

                android:paddingBottom="5dp"
                android:requiresFadingEdge="horizontal">

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/home_type_watching_btt"
                        style="@style/ChipFilled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:nextFocusLeft="@id/nav_rail_view"
                        android:nextFocusRight="@id/home_plan_to_watch_btt"
                        android:text="@string/type_watching" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/home_plan_to_watch_btt"
                        style="@style/ChipFilled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:nextFocusLeft="@id/home_type_watching_btt"
                        android:nextFocusRight="@id/home_type_on_hold_btt"
                        android:text="@string/type_plan_to_watch" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/home_type_on_hold_btt"
                        style="@style/ChipFilled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:nextFocusLeft="@id/home_plan_to_watch_btt"
                        android:nextFocusRight="@id/home_type_dropped_btt"
                        android:text="@string/type_on_hold" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/home_type_dropped_btt"
                        style="@style/ChipFilled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:nextFocusLeft="@id/home_type_on_hold_btt"
                        android:nextFocusRight="@id/home_type_completed_btt"
                        android:text="@string/type_dropped" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/home_type_completed_btt"
                        style="@style/ChipFilled"
                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"
                        android:nextFocusLeft="@id/home_type_dropped_btt"
                        android:text="@string/type_completed" />
                </com.google.android.material.chip.ChipGroup>

            </HorizontalScrollView>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/home_more_info"
                android:src="@drawable/ic_baseline_arrow_forward_24"
                app:drawableTint="?attr/white" />
        </FrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/home_bookmarked_child_recyclerview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:orientation="horizontal"
            android:paddingHorizontal="5dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/home_result_grid" />
    </LinearLayout>
</LinearLayout>
