<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/library_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0C10"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 60fps Hardware-Accelerated Dynamic Theme Shader -->
    <TextureView
        android:id="@+id/tv_library_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Dark Scrim Overlay -->
    <View
        android:id="@+id/tv_library_video_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_tv_search_video_overlay" />

    <!-- Top AppBar with Search Controls & Category Tabs -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:elevation="0dp">

        <!-- Top Search & Controls Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_scrollFlags="scroll|enterAlways">

            <!-- Sync Provider Selector (Open With / Provider) -->
            <ImageView
                android:id="@+id/provider_selector"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_mobile_search_circle_glass"
                android:contentDescription="@string/change_providers_img_des"
                android:padding="8dp"
                android:src="@drawable/ic_baseline_extension_24"
                app:tint="#FFFFFF" />

            <!-- True-Liquid-Glass Search Bar Capsule -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_mobile_search_pill_glass">

                <androidx.appcompat.widget.SearchView
                    android:id="@+id/main_search"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:iconifiedByDefault="false"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:nextFocusLeft="@id/nav_rail_view"
                    android:nextFocusRight="@id/list_selector"
                    app:closeIcon="@drawable/ic_baseline_close_24"
                    app:iconifiedByDefault="false"
                    app:queryBackground="@color/transparent"
                    app:queryHint="@string/search_hint"
                    app:searchIcon="@drawable/search_icon"
                    tools:ignore="RtlSymmetry" />
            </FrameLayout>

            <!-- Library Sync Source Selector (Local / Trakt / MAL) -->
            <ImageView
                android:id="@+id/list_selector"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_mobile_search_circle_glass"
                android:contentDescription="@string/select_library"
                android:padding="8dp"
                android:src="@drawable/baseline_sync_24"
                app:tint="#FFFFFF" />

            <!-- Hidden sort icon for 100% ViewBinding parity (handled via sort_fab) -->
            <ImageView
                android:id="@+id/library_sort"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:contentDescription="@string/sort"
                android:src="@drawable/ic_baseline_sort_24" />
        </LinearLayout>

        <!-- Category Tabs ("Watching", "Completed", "On-Hold", "Dropped", "Plan to Watch", "Favorites") -->
        <!-- Pinned under search controls with frosted glass pill styling -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/library_tab_layout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:background="@android:color/transparent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="true"
            app:layout_scrollFlags="noScroll"
            app:tabContentStart="8dp"
            app:tabPaddingStart="0dp"
            app:tabPaddingEnd="0dp"
            app:tabGravity="start"
            app:tabIndicator="@null"
            app:tabIndicatorHeight="0dp"
            app:tabMode="scrollable"
            app:tabRippleColor="@null"
            app:tabSelectedTextColor="#0B0E14"
            app:tabTextColor="#B3FFFFFF"
            app:tabTextAppearance="@style/TabNoCapsBold" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content Container: ViewPager & Loading & Empty State -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- ViewPager for content cards -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewpager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="140dp"
            tools:listitem="@layout/library_viewpager_page" />

        <!-- Empty List Text View -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/empty_list_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="Your Library is Empty\nBookmark titles while browsing to see them here."
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Loading Shimmer Placeholder Overlay -->
        <LinearLayout
            android:id="@+id/library_loading_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:visibility="gone"
            tools:visibility="gone">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/library_loading_shimmer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_margin="2dp"
                app:shimmer_auto_start="true"
                app:shimmer_base_alpha="0.2"
                app:shimmer_duration="@integer/loading_time"
                app:shimmer_highlight_alpha="0.3">

                <GridView
                    android:id="@+id/gridview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:gravity="center"
                    android:horizontalSpacing="8dp"
                    android:numColumns="3"
                    android:paddingBottom="140dp"
                    android:verticalSpacing="8dp"
                    tools:listitem="@layout/loading_poster_dynamic" />
            </com.facebook.shimmer.ShimmerFrameLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Floating Action Buttons Container -->
    <!-- Dynamically positioned above floating navbar (82dp + insets.bottom + 16dp) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Random Select Button -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/library_random"
            style="@style/ExtendedFloatingActionButton"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="16dp"
            android:text="@string/home_random"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D910141D"
            android:elevation="6dp"
            app:strokeColor="#40FFFFFF"
            app:strokeWidth="1.2dp"
            app:cornerRadius="100dp"
            app:icon="@drawable/ic_baseline_play_arrow_24"
            app:iconTint="#FFFFFF"
            android:visibility="gone"
            tools:ignore="ContentDescription"
            tools:visibility="visible" />

        <!-- Placeholder for TV layout random button - always hidden on phone -->
        <ImageView
            android:id="@+id/library_random_button_tv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- Sort Floating Action Button -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/sort_fab"
            style="@style/ExtendedFloatingActionButton"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:text="@string/sort"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D910141D"
            android:elevation="6dp"
            app:strokeColor="#40FFFFFF"
            app:strokeWidth="1.2dp"
            app:cornerRadius="100dp"
            app:icon="@drawable/ic_baseline_sort_24"
            app:iconTint="#FFFFFF"
            tools:ignore="ContentDescription" />
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
