<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/avatar_picker_dialog_root"
    android:layout_width="640dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/bg_tv_dialog_glass"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp"
    android:elevation="24dp">

    <!-- Header: Title, Subtitle, Close Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans"
                android:text="Choose Profile Avatar"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/google_sans"
                android:text="Select from library or enter a custom image URL"
                android:textColor="#9BA0A4"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_avatar_picker_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_tv_settings_action_pill"
            android:contentDescription="@string/go_back"
            android:focusable="true"
            android:clickable="true"
            android:padding="8dp"
            android:src="@drawable/ic_baseline_close_24"
            app:tint="@color/color_tv_settings_action_pill_text" />
    </RelativeLayout>

    <!-- Avatars Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/avatar_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        tools:listitem="@layout/item_profile_avatar_picker" />

    <!-- Bottom Actions Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_custom_url"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_tv_settings_action_pill"
            android:fontFamily="@font/google_sans"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:minHeight="0dp"
            android:gravity="center"
            android:singleLine="true"
            android:maxLines="1"
            android:textAllCaps="false"
            app:textAllCaps="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Custom URL"
            android:textColor="@color/color_tv_settings_action_pill_text"
            android:textSize="13sp"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_baseline_edit_24"
            app:iconSize="16dp"
            app:iconPadding="8dp"
            app:iconTint="@color/color_tv_settings_action_pill_text"
            android:focusable="true"
            android:clickable="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_avatar_picker_cancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_tv_settings_action_pill"
            android:fontFamily="@font/google_sans"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:minHeight="0dp"
            android:gravity="center"
            android:singleLine="true"
            android:maxLines="1"
            android:textAllCaps="false"
            app:textAllCaps="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/sort_cancel"
            android:textColor="@color/color_tv_settings_action_pill_text"
            android:textSize="13sp"
            app:backgroundTint="@null"
            android:focusable="true"
            android:clickable="true" />
    </LinearLayout>

</LinearLayout>
