<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/download_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0C10"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".ui.download.DownloadFragment">

    <!-- 60fps Hardware-Accelerated Dynamic Theme Shader -->
    <TextureView
        android:id="@+id/tv_downloads_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Dark Scrim Overlay -->
    <View
        android:id="@+id/tv_downloads_video_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_tv_search_video_overlay" />

    <!-- Top AppBar with Header, Storage Card, Queue Button & Batch Actions -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:elevation="0dp">

        <!-- Multi-Delete Action Bar (Visible during selection mode) -->
        <LinearLayout
            android:id="@+id/download_delete_appbar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_mobile_glass_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnCancel"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_mobile_search_circle_glass"
                android:contentDescription="@string/cancel"
                android:padding="6dp"
                android:src="@drawable/ic_baseline_close_24"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/selectItemsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/google_sans"
                android:text="@string/downloads_delete_select"
                android:textColor="#E9EAEE"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnDelete"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_tv_danger_action_pill"
                android:fontFamily="@font/google_sans"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/delete"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnToggleAll"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_tv_download_action_pill"
                android:fontFamily="@font/google_sans"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/select_all"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Main Downloads Header: Title & Emblem -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="4dp"
            app:layout_scrollFlags="scroll|enterAlways">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/splash_logo_white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/google_sans"
                android:text="@string/title_downloads"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- True-Liquid-Glass Storage & Queue Card -->
        <LinearLayout
            android:id="@+id/download_appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_mobile_glass_card"
            android:orientation="vertical"
            android:padding="14dp"
            app:layout_scrollFlags="scroll|enterAlways">

            <!-- Storage Information Block -->
            <LinearLayout
                android:id="@+id/download_storage_appbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Title & Shimmer Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/google_sans"
                        android:text="@string/download_storage_text"
                        android:textColor="#E9EAEE"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/download_loading_bytes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        app:shimmer_auto_start="true"
                        app:shimmer_base_alpha="0.2"
                        app:shimmer_duration="@integer/loading_time"
                        tools:ignore="MissingClass">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/google_sans"
                            android:text="Calculating..."
                            android:textColor="#9BA0A4"
                            android:textSize="11sp" />
                    </com.facebook.shimmer.ShimmerFrameLayout>
                </LinearLayout>

                <!-- Modern Multi-Segment Storage Progress Bar -->
                <LinearLayout
                    android:id="@+id/download_bytes_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginBottom="8dp"
                        app:cardBackgroundColor="#26FFFFFF"
                        app:cardCornerRadius="4dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/download_used"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.4"
                                android:background="#6366F1" />

                            <View
                                android:id="@+id/download_app"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.2"
                                android:background="#10B981" />

                            <View
                                android:id="@+id/download_free"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.4"
                                android:background="#374151" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Storage Legend Text Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Used Indicator -->
                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/storage_bar_left_box"
                            android:layout_marginEnd="5dp" />

                        <TextView
                            android:id="@+id/download_used_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#C0C5CC"
                            android:textSize="11sp"
                            android:fontFamily="@font/google_sans"
                            tools:text="Used • 30.58 GB" />

                        <!-- App Indicator -->
                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/storage_bar_mid_box"
                            android:layout_marginStart="14dp"
                            android:layout_marginEnd="5dp" />

                        <TextView
                            android:id="@+id/download_app_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#C0C5CC"
                            android:textSize="11sp"
                            android:fontFamily="@font/google_sans"
                            tools:text="App • 3.20 GB" />

                        <!-- Free Indicator -->
                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/storage_bar_right_box"
                            android:layout_marginStart="14dp"
                            android:layout_marginEnd="5dp" />

                        <TextView
                            android:id="@+id/download_free_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#C0C5CC"
                            android:textSize="11sp"
                            android:fontFamily="@font/google_sans"
                            tools:text="Free • 58.12 GB" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Divider line inside card -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="#14FFFFFF" />

            <!-- Card Bottom Row: Queue Status Action Button + Network Stream Action -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Download Queue Status Action Button (Repositioned above navbar) -->
                <LinearLayout
                    android:id="@+id/download_queue_button"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tv_download_action_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/baseline_downloading_24"
                        app:tint="#818CF8" />

                    <TextView
                        android:id="@+id/download_queue_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/google_sans"
                        android:text="@string/download_queue"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Network Stream Dialog Button -->
                <ImageView
                    android:id="@+id/download_stream_button_tv"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_mobile_search_circle_glass"
                    android:clickable="true"
                    android:contentDescription="@string/stream"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_network_stream"
                    app:tint="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <!-- Batch Action Pills Row ("Pause All", "Resume All", "Clear Queue") -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            app:layout_scrollFlags="noScroll">

            <!-- Pause All Pill -->
            <TextView
                android:id="@+id/btn_tv_pause_all"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_tv_download_action_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/pause"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:fontFamily="@font/google_sans"
                app:drawableStartCompat="@drawable/ic_baseline_pause_24"
                app:drawableTint="#FFFFFF"
                android:drawablePadding="5dp" />

            <!-- Resume All Pill -->
            <TextView
                android:id="@+id/btn_tv_resume_all"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_tv_download_action_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/resume"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:fontFamily="@font/google_sans"
                app:drawableStartCompat="@drawable/ic_baseline_play_arrow_24"
                app:drawableTint="#FFFFFF"
                android:drawablePadding="5dp" />

            <!-- Clear Queue Pill -->
            <TextView
                android:id="@+id/btn_tv_clear_completed"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_tv_download_action_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Clear Queue"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:fontFamily="@font/google_sans"
                app:drawableStartCompat="@drawable/ic_baseline_delete_outline_24"
                app:drawableTint="#FFFFFF"
                android:drawablePadding="5dp" />
        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content Container: Download List & Empty State -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Shimmer Loading Placeholder -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/download_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="12dp"
            app:shimmer_auto_start="true"
            app:shimmer_base_alpha="0.2"
            app:shimmer_duration="@integer/loading_time"
            app:shimmer_highlight_alpha="0.3"
            tools:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:orientation="vertical">

                <include layout="@layout/loading_downloads" />
                <include layout="@layout/loading_downloads" />
                <include layout="@layout/loading_downloads" />
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <!-- Download List RecyclerView (padded bottom to clear floating navbar) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/download_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="140dp"
            android:descendantFocusability="afterDescendants"
            tools:listitem="@layout/download_header_episode" />

        <!-- Empty State Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/netflix_download"
                app:tint="#818CF8" />

            <TextView
                android:id="@+id/text_no_downloads"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/google_sans"
                android:text="@string/downloads_empty"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:gravity="center"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </FrameLayout>

    <!-- Floating Action Buttons Container (Docked cleanly above floating navbar) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:orientation="vertical">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/open_local_video_button"
            style="?attr/floatingActionButtonSmallStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#D910141D"
            android:contentDescription="@string/open_local_video"
            android:src="@drawable/netflix_play"
            app:tint="#FFFFFF"
            app:strokeColor="#40FFFFFF"
            app:strokeWidth="1.2dp"
            android:elevation="6dp"
            android:tooltipText="@string/open_local_video" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/download_stream_button"
            style="@style/ExtendedFloatingActionButton"
            android:contentDescription="@string/stream"
            android:text="@string/stream"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D910141D"
            app:strokeColor="#40FFFFFF"
            app:strokeWidth="1.2dp"
            app:cornerRadius="100dp"
            android:elevation="6dp"
            app:icon="@drawable/ic_network_stream"
            app:iconTint="#FFFFFF" />
    </LinearLayout>

    <!-- Hidden stub for 100% ViewBinding parity -->
    <LinearLayout
        android:id="@+id/steam_imageview_holder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>