<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_root"
    android:layout_width="match_parent"

    android:layout_height="match_parent"
    tools:context=".ui.home.HomeFragment">

    <FrameLayout
        android:id="@+id/home_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="visible">

        <ProgressBar
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:visibility="gone"
            tools:visibility="gone" />

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/home_loading_shimmer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_marginTop="15dp"
            android:orientation="vertical"
            android:paddingTop="40dp"
            app:shimmer_auto_start="true"
            app:shimmer_base_alpha="0.2"
            app:shimmer_duration="@integer/loading_time"
            app:shimmer_highlight_alpha="0.3">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:layout_width="125dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/loading_margin"
                        android:background="@color/grayShimmer"
                        android:translationX="-164dp"
                        app:cardCornerRadius="@dimen/loading_radius" />

                    <androidx.cardview.widget.CardView
                        android:layout_width="148dp"
                        android:layout_height="234dp"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/loading_margin"
                        android:background="@color/grayShimmer"
                        app:cardCornerRadius="@dimen/loading_radius" />

                    <androidx.cardview.widget.CardView
                        android:layout_width="125dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/loading_margin"
                        android:background="@color/grayShimmer"
                        android:translationX="164dp"
                        app:cardCornerRadius="@dimen/loading_radius" />
                </FrameLayout>

                <include layout="@layout/loading_line_short_center" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/result_padding"
                    android:layout_marginTop="@dimen/result_padding"

                    android:layout_marginEnd="@dimen/result_padding"
                    android:orientation="vertical">

                    <include layout="@layout/loading_list" />

                    <include layout="@layout/loading_list" />

                    <include layout="@layout/loading_list" />
                </LinearLayout>
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <LinearLayout
            android:id="@+id/home_api_holder"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:layout_margin="10dp"
            android:background="@color/transparent"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_change_api_loading_legacy"
                style="@style/RegularButtonTV"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/home_preview_reload_provider"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="@drawable/player_button_tv_attr_no_bg"
                android:contentDescription="@string/reload_provider"
                android:focusable="true"
                android:nextFocusLeft="@id/home_change_api"
                android:nextFocusRight="@id/home_preview_search_button"
                android:nextFocusUp="@id/home_preview_reload_provider"
                android:nextFocusDown="@id/home_preview_info_btt"
                android:padding="10dp"
                android:src="@drawable/ic_refresh"
                android:tag="@string/tv_no_focus_tag"
                android:visibility="gone"
                app:tint="@color/player_on_button_tv_attr" />

            <ImageView
                android:id="@+id/home_preview_search_button"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="@drawable/player_button_tv_attr_no_bg"
                android:contentDescription="@string/search"
                android:nextFocusLeft="@id/home_change_api"
                android:nextFocusRight="@id/home_switch_account"
                android:nextFocusDown="@id/home_preview_info_btt"
                android:padding="10dp"
                android:src="@drawable/search_icon"
                android:tag="@string/tv_no_focus_tag"
                android:visibility="gone"
                app:tint="@color/player_on_button_tv_attr" />

            <ImageView
                android:id="@+id/home_switch_account"

                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/account"
                android:nextFocusLeft="@id/home_search"
                android:padding="10dp"
                android:src="@drawable/ic_outline_account_circle_24" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/home_loading_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_reload_connectionerror"
            style="@style/WhiteButton"

            android:layout_width="wrap_content"

            android:layout_gravity="center"
            android:layout_margin="5dp"
            android:minWidth="200dp"
            android:text="@string/reload_error"
            app:icon="@drawable/ic_baseline_autorenew_24" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_reload_connection_open_in_browser"
            style="@style/BlackButton"

            android:layout_width="wrap_content"

            android:layout_gravity="center"
            android:layout_margin="5dp"
            android:minWidth="200dp"
            android:text="@string/result_open_in_browser"
            app:icon="@drawable/ic_baseline_public_24" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_reload_connection_go_to_downloads"
            style="@style/BlackButton"

            android:layout_width="wrap_content"

            android:layout_gravity="center"
            android:layout_margin="5dp"
            android:minWidth="200dp"
            android:text="@string/go_to_downloads"
            app:icon="@drawable/netflix_download" />

        <TextView
            android:id="@+id/result_error_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="5dp"
            android:gravity="center"
            android:textColor="?attr/textColor" />
    </LinearLayout>

    <!-- Fullscreen Extended Atmospheric Backdrop Layer (Matches Carousel Colors) -->
    <FrameLayout
        android:id="@+id/home_tv_backdrop_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/home_tv_backdrop_image_a"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/home_tv_backdrop_image_b"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:alpha="0"
            tools:ignore="ContentDescription" />

        <!-- Extended Ambient Gradient Overlay -->
        <View
            android:id="@+id/home_tv_backdrop_gradient"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_mobile_home_extended_gradient" />
    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/home_master_recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="96dp"
        android:descendantFocusability="afterDescendants"
        android:nextFocusLeft="@id/nav_rail_view"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/homepage_parent"
        tools:visibility="gone" />

    <ImageView
        android:id="@+id/home_scroll_to_top"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="90dp"
        android:background="@drawable/bg_mobile_glass_fab"
        android:contentDescription="@string/home_more_info"
        android:padding="11dp"
        android:src="@drawable/ic_baseline_arrow_upward_24"
        android:visibility="gone"
        android:elevation="6dp"
        app:tint="@color/white" />

    <TextClock
            android:id="@+id/home_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/home_api_fab"
        style="@style/ExtendedFloatingActionButton"
        android:text="@string/home_source"
        android:textColor="?attr/textColor"
        android:visibility="gone"
        app:icon="@drawable/ic_baseline_filter_list_24"
        tools:ignore="ContentDescription"
        tools:visibility="visible" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/home_random"
        style="@style/ExtendedFloatingActionButton"
        android:layout_gravity="bottom|start"
        android:text="@string/home_random"
        android:textColor="?attr/textColor"
        android:visibility="gone"
        app:icon="@drawable/ic_baseline_play_arrow_24"
        tools:ignore="ContentDescription"
        tools:visibility="visible" />

    <!-- Placeholder for TV layout random button - always hidden on phone -->
    <ImageView
        android:id="@+id/home_random_button_tv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Placeholder for TV layout settings button - always hidden on phone -->
    <ImageView
        android:id="@+id/home_preview_settings_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Pinned Top Brand Bar: Logo + Provider Selector Pill + Search Button (Left) & Profile (Right) -->
    <LinearLayout
        android:id="@+id/home_pinned_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="52dp"
        android:paddingBottom="12dp"
        android:elevation="12dp"
        android:background="@drawable/bg_mobile_hero_top_gradient">

        <!-- App Logo (Transparent Pure White Emblem - like TV layout had) -->
        <ImageView
            android:id="@+id/home_mobile_logo"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/splash_logo_white"
            android:scaleType="fitCenter" />

        <!-- Glassmorphic Provider Selector Pill with Real Optical Blur -->
        <eightbitlab.com.blurview.BlurView
            android:id="@+id/home_change_api_blur"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            app:blurOverlayColor="@android:color/transparent">

            <TextView
                android:id="@+id/home_change_api"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_mobile_top_pill_glass"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Provider ▾"
                android:textColor="#F3F4F6"
                android:textSize="12.5sp"
                android:fontFamily="@font/google_sans"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </eightbitlab.com.blurview.BlurView>

        <!-- Glassmorphic Search Button with Real Optical Blur -->
        <eightbitlab.com.blurview.BlurView
            android:id="@+id/home_plugin_search_blur"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="2dp"
            app:blurOverlayColor="@android:color/transparent">

            <ImageView
                android:id="@+id/home_plugin_search_btn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_mobile_top_pill_glass"
                android:scaleType="centerInside"
                android:src="@drawable/search_icon"
                app:tint="#F3F4F6"
                android:padding="9dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/search" />
        </eightbitlab.com.blurview.BlurView>

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Profile Avatar (Right) -->
        <LinearLayout
            android:id="@+id/home_head_profile_padding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:id="@+id/home_head_profile_card"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:background="@color/transparent"
                app:cardCornerRadius="17dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/transparent">

                <ImageView
                    android:id="@+id/home_head_profile_pic"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/account"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/profile_bg_orange" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>

    <!-- Dedicated In-Plugin Search Overlay (Mobile portrait optimized with procedural video background) -->
    <FrameLayout
        android:id="@+id/home_plugin_search_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF07090D"
        android:visibility="gone"
        android:elevation="40dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:clickable="true"
        android:focusable="true">

        <!-- Ambient Video Loop TextureView -->
        <TextureView
            android:id="@+id/home_plugin_search_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Atmospheric Dark Vignette Overlay -->
        <View
            android:id="@+id/home_plugin_search_gradient"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_mobile_search_video_overlay" />

        <!-- Main Column Layout -->
        <LinearLayout
            android:id="@+id/home_plugin_search_main_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:clipChildren="true"
            android:clipToPadding="true">

            <!-- Top Search Header (Padded below status bar via WindowInsets) -->
            <LinearLayout
                android:id="@+id/home_plugin_search_header_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="36dp"
                android:paddingBottom="20dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- True-Liquid-Glass Circular Back Button -->
                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/home_plugin_search_back_blur"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:blurOverlayColor="@android:color/transparent">

                    <ImageView
                        android:id="@+id/home_plugin_search_back"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_mobile_search_circle_glass"
                        android:contentDescription="@string/go_back"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp"
                        android:src="@drawable/ic_baseline_arrow_back_24"
                        app:tint="#FFFFFF" />
                </eightbitlab.com.blurview.BlurView>

                <!-- True-Liquid-Glass Search Capsule Bar -->
                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/home_plugin_search_bar_blur"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    app:blurOverlayColor="@android:color/transparent">

                    <LinearLayout
                        android:id="@+id/home_plugin_search_bar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_mobile_search_pill_glass"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:id="@+id/home_plugin_search_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/search_icon"
                            app:tint="#FFFFFF"
                            android:contentDescription="@string/search" />

                        <EditText
                            android:id="@+id/home_plugin_search_input"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="6dp"
                            android:background="@android:color/transparent"
                            android:fontFamily="@font/google_sans"
                            android:hint="@string/tv_search_hint"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#99FFFFFF"
                            android:textSize="14sp" />

                        <ProgressBar
                            android:id="@+id/home_plugin_search_loading"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:indeterminate="true"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/home_plugin_search_clear"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_mobile_search_circle_glass"
                            android:src="@drawable/ic_baseline_clear_24"
                            android:padding="4dp"
                            android:visibility="gone"
                            android:clickable="true"
                            android:focusable="true"
                            app:tint="#FFFFFF"
                            android:contentDescription="@string/clear" />
                    </LinearLayout>
                </eightbitlab.com.blurview.BlurView>
            </LinearLayout>

            <!-- Content Area (Section Title + Recycler Grid + Empty State) -->
            <LinearLayout
                android:id="@+id/home_plugin_search_content_group"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:clipChildren="true"
                android:clipToPadding="true">

                <!-- Section Title: "Trending Today" / Query Results -->
                <TextView
                    android:id="@+id/home_plugin_search_section_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="14dp"
                    android:fontFamily="@font/google_sans"
                    android:text="@string/tv_trending_today"
                    android:textColor="#E9EAEE"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Empty Results Message -->
                <TextView
                    android:id="@+id/home_plugin_search_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="50dp"
                    android:fontFamily="@font/google_sans"
                    android:text="@string/tv_no_results_found"
                    android:textColor="#8A99AD"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <!-- Responsive Card Grid Recycler -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/home_plugin_search_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipChildren="true"
                    android:clipToPadding="true"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="80dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>