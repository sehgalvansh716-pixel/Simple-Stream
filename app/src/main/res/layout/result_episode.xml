<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/episode_holder"
    android:layout_width="220dp"
    android:layout_height="56dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="4dp"
    android:nextFocusRight="@id/download_button"
    app:cardBackgroundColor="#10141D"
    app:cardCornerRadius="12dp"
    app:cardPreventCornerOverlap="false"
    app:cardElevation="0dp"
    android:foreground="@drawable/outline_active_episode">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="?android:attr/selectableItemBackgroundBorderless"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <FrameLayout
            android:id="@+id/watch_progress_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical">

            <ImageView
                android:id="@+id/episode_play_icon"
                style="@style/ContinueWatchingPlayUnderlayProgress"
                android:layout_margin="4dp" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/episode_progress"
                style="@style/ContinueWatchingCircularProgress" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/episode_filler"
            style="@style/SmallWhiteButton"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:text="@string/filler" />

        <TextView
            android:id="@+id/episode_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="marquee"
            android:gravity="center_vertical"
            android:marqueeRepeatLimit="0"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/google_sans"
            tools:text="Episode 1" />

        <com.lagradost.cloudstream3.ui.download.button.PieFetchButton
            android:id="@+id/download_button"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="center_vertical"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="6dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>