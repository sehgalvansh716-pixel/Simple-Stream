<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.HomeFragment">

    <!-- Loading Shimmer State -->
    <FrameLayout
        android:id="@+id/home_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="0dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ProgressBar
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:visibility="gone"
            tools:visibility="gone" />

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/home_loading_shimmer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_marginTop="15dp"
            android:orientation="vertical"
            android:paddingTop="40dp"
            app:shimmer_auto_start="true"
            app:shimmer_base_alpha="0.2"
            app:shimmer_duration="@integer/loading_time"
            app:shimmer_highlight_alpha="0.3">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:layout_width="125dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/loading_margin"
                        android:background="@color/grayShimmer"
                        android:translationX="-164dp"
                        app:cardCornerRadius="@dimen/loading_radius" />

                    <androidx.cardview.widget.CardView
                        android:layout_width="148dp"
                        android:layout_height="234dp"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/loading_margin"
                        android:background="@color/grayShimmer"
                        app:cardCornerRadius="@dimen/loading_radius" />

                    <androidx.cardview.widget.CardView
                        android:layout_width="125dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/loading_margin"
                        android:background="@color/grayShimmer"
                        android:translationX="164dp"
                        app:cardCornerRadius="@dimen/loading_radius" />
                </FrameLayout>

                <include layout="@layout/loading_line_short_center" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/result_padding"
                    android:layout_marginTop="@dimen/result_padding"
                    android:layout_marginEnd="@dimen/result_padding"
                    android:orientation="vertical">

                    <include layout="@layout/loading_list" />

                    <include layout="@layout/loading_list" />

                    <include layout="@layout/loading_list" />
                </LinearLayout>
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>
    </FrameLayout>

    <!-- Error State -->
    <LinearLayout
        android:id="@+id/home_loading_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_reload_connectionerror"
            style="@style/WhiteButton"
            android:layout_width="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="5dp"
            android:minWidth="200dp"
            android:text="@string/reload_error"
            app:icon="@drawable/ic_baseline_autorenew_24" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_reload_connection_open_in_browser"
            style="@style/BlackButton"
            android:layout_width="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="5dp"
            android:minWidth="200dp"
            android:text="@string/result_open_in_browser"
            app:icon="@drawable/ic_baseline_public_24" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_reload_connection_go_to_downloads"
            style="@style/BlackButton"
            android:layout_width="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="5dp"
            android:minWidth="200dp"
            android:text="@string/go_to_downloads"
            app:icon="@drawable/netflix_download" />

        <TextView
            android:id="@+id/result_error_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="5dp"
            android:gravity="center"
            android:textColor="?attr/textColor" />
    </LinearLayout>

    <!-- Fullscreen Extended Atmospheric Backdrop Layer (Matches Carousel Colors) -->
    <FrameLayout
        android:id="@+id/home_tv_backdrop_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/home_tv_backdrop_image_a"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/home_tv_backdrop_image_b"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:alpha="0"
            tools:ignore="ContentDescription" />

        <!-- Extended Ambient Gradient Overlay -->
        <View
            android:id="@+id/home_tv_backdrop_gradient"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_tv_home_extended_gradient" />
    </FrameLayout>

    <!-- Master Recycler (Full Screen, holding the Hero Billboard and Content Rails) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/home_master_recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/homepage_parent_tv" />

    <!-- Clock (Preserved for ViewBinding, hidden) -->
    <TextClock
        android:id="@+id/home_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- Compatibility Provider Views for ViewBinding (Real UI is inside fragment_home_head_tv) -->
    <LinearLayout
        android:id="@+id/home_api_holder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:descendantFocusability="blocksDescendants"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_change_api"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:focusable="false"
            android:focusableInTouchMode="false" />

        <!-- Hidden compatibility views for ViewBinding in HomeFragment -->
        <ImageView
            android:id="@+id/home_preview_settings_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/home_preview_reload_provider"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/home_preview_search_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/home_random_button_tv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/home_switch_account"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_change_api_loading_legacy"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/home_pinned_top_bar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/home_mobile_logo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/home_plugin_search_btn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/home_change_api_blur"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/home_plugin_search_blur"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/home_plugin_search_back_blur"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/home_plugin_search_bar_blur"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/home_head_profile_padding"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">

            <androidx.cardview.widget.CardView
                android:id="@+id/home_head_profile_card"
                android:layout_width="0dp"
                android:layout_height="0dp">

                <ImageView
                    android:id="@+id/home_head_profile_pic"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Placeholder for mobile scroll-to-top FAB - always hidden on TV -->
        <ImageView
            android:id="@+id/home_scroll_to_top"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/home_api_fab"
        style="@style/ExtendedFloatingActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/home_random"
        style="@style/ExtendedFloatingActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- In-Plugin Search Overlay (Matches PluginSearchbarExample.png & TV lay bg video) -->
    <FrameLayout
        android:id="@+id/home_plugin_search_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF07090D"
        android:visibility="gone"
        android:elevation="25dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:clickable="true"
        android:focusable="true">

        <!-- Looping Green Silk Background Video -->
        <TextureView
            android:id="@+id/home_plugin_search_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Atmospheric Dark Gradient & Vignette Overlay -->
        <View
            android:id="@+id/home_plugin_search_gradient"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_tv_search_video_overlay" />

        <!-- Top-Left Back Button & Logo -->
        <LinearLayout
            android:id="@+id/home_plugin_search_top_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|top"
            android:layout_marginStart="36dp"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:elevation="6dp">

            <ImageView
                android:id="@+id/home_plugin_search_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/go_back"
                android:focusable="true"
                android:clickable="true"
                android:padding="6dp"
                android:src="@drawable/ic_baseline_arrow_back_24"
                app:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/home_plugin_search_logo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/splash_logo_white" />
        </LinearLayout>

        <!-- Main Content Area -->
        <LinearLayout
            android:id="@+id/home_plugin_search_main_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Search Header Group (Permanently Anchored at Top) -->
            <LinearLayout
                android:id="@+id/home_plugin_search_header_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:elevation="4dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Headline: "Let's find a movie night pick" -->
                <TextView
                    android:id="@+id/home_plugin_search_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="60dp"
                    android:fontFamily="@font/google_sans"
                    android:text="@string/tv_movie_night_pick"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Glassmorphic Search Bar Capsule -->
                <LinearLayout
                    android:id="@+id/home_plugin_search_bar"
                    android:layout_width="600dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="18dp"
                    android:background="@drawable/bg_tv_search_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:id="@+id/home_plugin_search_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/search_icon"
                        app:tint="#80FFFFFF"
                        android:contentDescription="@string/search" />

                    <EditText
                        android:id="@+id/home_plugin_search_input"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/google_sans"
                        android:hint="@string/tv_search_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#80FFFFFF"
                        android:textSize="15sp"
                        android:nextFocusUp="@+id/home_plugin_search_input"
                        android:nextFocusDown="@+id/home_plugin_search_recycler" />

                    <ProgressBar
                        android:id="@+id/home_plugin_search_loading"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:indeterminate="true"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/home_plugin_search_clear"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_baseline_clear_24"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="3dp"
                        android:visibility="gone"
                        android:focusable="true"
                        android:clickable="true"
                        app:tint="#80FFFFFF"
                        android:contentDescription="@string/clear" />
                </LinearLayout>
            </LinearLayout>

            <!-- Content Group (Section Title + Recycler Grid with Viewport Clipping) -->
            <LinearLayout
                android:id="@+id/home_plugin_search_content_group"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:clipChildren="true"
                android:clipToPadding="true">

                <!-- Section Title: "Trending Today" / Query Results -->
                <TextView
                    android:id="@+id/home_plugin_search_section_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="@font/google_sans"
                    android:text="@string/tv_trending_today"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- Empty Results Message -->
                <TextView
                    android:id="@+id/home_plugin_search_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="40dp"
                    android:fontFamily="@font/google_sans"
                    android:text="@string/tv_no_results_found"
                    android:textColor="#8A99AD"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <!-- 5-Column Search Results Recycler Grid -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/home_plugin_search_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipChildren="true"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:paddingStart="36dp"
                    android:paddingEnd="36dp"
                    android:paddingTop="28dp"
                    android:paddingBottom="64dp"
                    android:nextFocusUp="@+id/home_plugin_search_input" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>