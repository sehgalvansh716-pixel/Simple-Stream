<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tv_dialog_container"
    android:layout_width="440dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tv_dialog_glass"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="22dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <!-- Dialog Header -->
    <TextView
        android:id="@+id/tv_provider_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/google_sans"
        android:text="Select Provider"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_provider_dialog_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/google_sans"
        android:text="Choose content catalog source"
        android:textColor="#80FFFFFF"
        android:textSize="12sp" />

    <!-- Providers List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tv_provider_recycler"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:scrollbars="vertical"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_tv_provider" />

</LinearLayout>
