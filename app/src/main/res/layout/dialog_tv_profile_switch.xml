<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tv_profile_dialog_root"
    android:layout_width="640dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/bg_tv_dialog_glass"
    android:orientation="vertical"
    android:paddingStart="36dp"
    android:paddingEnd="36dp"
    android:paddingTop="28dp"
    android:paddingBottom="28dp"
    android:elevation="24dp">

    <!-- Header: Title & Close Icon -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans"
                android:text="@string/switch_account"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/google_sans"
                android:text="Select a profile to continue watching"
                android:textColor="#9BA0A4"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_dialog_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_tv_settings_action_pill"
            android:contentDescription="@string/go_back"
            android:focusable="true"
            android:clickable="true"
            android:padding="8dp"
            android:src="@drawable/ic_baseline_close_24"
            app:tint="@color/color_tv_settings_action_pill_text" />
    </RelativeLayout>

    <!-- Profiles Horizontal Carousel -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/account_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:itemCount="3"
        tools:listitem="@layout/account_list_item" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_account_button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_tv_settings_action_pill"
            android:fontFamily="@font/google_sans"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:minHeight="0dp"
            android:gravity="center"
            android:singleLine="true"
            android:maxLines="1"
            android:textAllCaps="false"
            app:textAllCaps="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/add_account"
            android:textColor="@color/color_tv_settings_action_pill_text"
            android:textSize="13sp"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_baseline_add_24"
            app:iconSize="16dp"
            app:iconPadding="8dp"
            app:iconTint="@color/color_tv_settings_action_pill_text"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusUp="@id/account_recycler_view"
            android:nextFocusRight="@id/manage_accounts_button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/manage_accounts_button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_tv_settings_action_pill"
            android:fontFamily="@font/google_sans"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:minHeight="0dp"
            android:gravity="center"
            android:singleLine="true"
            android:maxLines="1"
            android:textAllCaps="false"
            app:textAllCaps="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/manage_accounts"
            android:textColor="@color/color_tv_settings_action_pill_text"
            android:textSize="13sp"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_baseline_edit_24"
            app:iconSize="16dp"
            app:iconPadding="8dp"
            app:iconTint="@color/color_tv_settings_action_pill_text"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusUp="@id/account_recycler_view"
            android:nextFocusLeft="@id/add_account_button" />
    </LinearLayout>

</LinearLayout>
