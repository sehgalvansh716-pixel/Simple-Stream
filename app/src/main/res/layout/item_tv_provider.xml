<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tv_provider_item_root"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:background="@drawable/bg_tv_dropdown_item"
    android:clickable="true"
    android:focusable="true"
    android:tag="@string/tv_no_focus_tag"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="16dp">

    <!-- Minimalistic Tick / Checkmark Icon -->
    <ImageView
        android:id="@+id/tv_provider_item_tick"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="Selected"
        android:src="@drawable/ic_baseline_check_24"
        android:duplicateParentState="true"
        app:tint="@color/color_tv_dropdown_item_text"
        tools:visibility="visible" />

    <!-- Provider Display Name -->
    <TextView
        android:id="@+id/tv_provider_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/google_sans"
        android:duplicateParentState="true"
        android:maxLines="1"
        android:textColor="@color/color_tv_dropdown_item_text"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="NetMirror - Netflix" />

</LinearLayout>
