<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_mobile_sheet_glass">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Centered Drag Pill Handle -->
        <View
            android:layout_width="38dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_mobile_nav_pill_active" />

        <!-- Header Row with Dynamic Title and Glass Close Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/select_mainpage_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/google_sans"
                android:text="@string/home_source"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/select_mainpage_close"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_mobile_search_circle_glass"
                android:contentDescription="@string/go_back"
                android:padding="6dp"
                android:src="@drawable/ic_baseline_close_24"
                app:tint="#CCFFFFFF" />
        </LinearLayout>

        <!-- Media Type Category Filter Chips -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <include
                android:id="@+id/tvtypes_chips_scroll"
                layout="@layout/tvtypes_chips_scroll" />
        </FrameLayout>

        <!-- Glass Hairline Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="6dp"
            android:background="#14FFFFFF" />

        <!-- Scrollable Provider / Source List -->
        <ListView
            android:id="@+id/listview1"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="3dp"
            android:nestedScrollingEnabled="true"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:scrollbars="vertical"
            tools:listitem="@layout/sort_bottom_single_provider_choice" />

        <!-- Action Buttons Holder (Visible for Search Multi-Filter) -->
        <LinearLayout
            android:id="@+id/apply_btt_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel_btt"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_mobile_top_pill_glass"
                app:backgroundTint="@null"
                android:fontFamily="@font/google_sans"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textAllCaps="false"
                app:textAllCaps="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/sort_cancel"
                android:textColor="#E0E7FF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/apply_btt"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_tv_settings_action_pill"
                app:backgroundTint="@null"
                android:fontFamily="@font/google_sans"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:textAllCaps="false"
                app:textAllCaps="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/sort_apply"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>