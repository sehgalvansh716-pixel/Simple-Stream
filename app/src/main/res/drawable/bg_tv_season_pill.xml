<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: 2dp crisp white focus ring on brightened neutral specular frosted glass (1dp inset for perfect antialiasing) -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <solid android:color="#66000000" />
                </shape>
            </item>
            <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#59FFFFFF"
                        android:centerColor="#33FFFFFF"
                        android:endColor="#1AFFFFFF" />
                    <stroke android:width="2dp" android:color="#FFFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Selected state -->
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <solid android:color="#66000000" />
                </shape>
            </item>
            <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#59FFFFFF"
                        android:centerColor="#33FFFFFF"
                        android:endColor="#1AFFFFFF" />
                    <stroke android:width="2dp" android:color="#FFFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <solid android:color="#80000000" />
                </shape>
            </item>
            <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#66FFFFFF"
                        android:endColor="#33FFFFFF" />
                    <stroke android:width="2dp" android:color="#FFFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default state: True-Liquid-Glass neutral translucent frosted glass capsule pill -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <solid android:color="#4D000000" />
                </shape>
            </item>
            <item android:top="0.5dp" android:bottom="0.5dp" android:left="0.5dp" android:right="0.5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#26FFFFFF"
                        android:centerColor="#14FFFFFF"
                        android:endColor="#0DFFFFFF" />
                    <stroke android:width="1.2dp" android:color="#38FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
