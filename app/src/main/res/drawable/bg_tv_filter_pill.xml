<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: Brightened translucent glass with crisp 2dp white stroke -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <solid android:color="#99060A10" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <solid android:color="#331A2636" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#4DFFFFFF"
                        android:centerColor="#26FFFFFF"
                        android:endColor="#14FFFFFF" />
                    <stroke android:width="2dp" android:color="#FFFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Activated / Selected / Checked state: Solid white active pill -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>

    <!-- Default state: Frosted matte dark specular glass pill with subtle refractive border -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <solid android:color="#8006090F" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <solid android:color="#24141E2C" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#24FFFFFF"
                        android:centerColor="#10FFFFFF"
                        android:endColor="#06FFFFFF" />
                    <stroke android:width="1dp" android:color="#38FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
