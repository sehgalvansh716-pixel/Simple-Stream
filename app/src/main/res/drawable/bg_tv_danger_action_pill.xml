<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: Solid crimson highlight with 2dp white stroke -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#FFFF4D4D" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
        </shape>
    </item>

    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#E03838" />
        </shape>
    </item>

    <!-- Default state: Translucent crimson glass with subtle red border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#2E4A1515" />
            <stroke android:width="1dp" android:color="#66FF4D4D" />
        </shape>
    </item>
</selector>
