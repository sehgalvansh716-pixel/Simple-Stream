<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: Crisp solid white capsule matching top navbar Home button -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#FFFFFFFF" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <!-- Selected / Active state: Translucent glass with subtle glowing border -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#33FFFFFF" />
            <stroke android:width="1.5dp" android:color="#80FFFFFF" />
        </shape>
    </item>
    <!-- Default state: Translucent neutral glass pill -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#14FFFFFF" />
            <stroke android:width="1dp" android:color="#20FFFFFF" />
        </shape>
    </item>
</selector>
