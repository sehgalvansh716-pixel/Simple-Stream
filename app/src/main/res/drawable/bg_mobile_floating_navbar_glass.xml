<?xml version="1.0" encoding="utf-8"?>
<!-- True-Liquid-Glass Untinted Floating Bottom Navigation Bar Capsule for Mobile -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Layer 0: Crystal Clear Base (No dark or color tint) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

    <!-- Layer 1: Subtle Ambient Frost Glaze (Micro-sheen for depth without darkening) -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="31dp" />
            <gradient
                android:angle="270"
                android:startColor="#18FFFFFF"
                android:centerColor="#04FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- Layer 2: Top Edge Specular Glare Line -->
    <item
        android:top="1dp"
        android:left="24dp"
        android:right="24dp"
        android:bottom="61dp">
        <shape android:shape="rectangle">
            <corners android:radius="1dp" />
            <gradient
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#55FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- Layer 3: Specular Refractive Perimeter Rim (Razor-sharp crisp glass edge) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1.2dp"
                android:color="#45FFFFFF" />
        </shape>
    </item>
</layer-list>
