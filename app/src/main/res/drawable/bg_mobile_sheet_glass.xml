<?xml version="1.0" encoding="utf-8"?>
<!-- True-Liquid-Glass Sheet Background for Mobile Modals and Bottom Sheets -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Layer 0: Deep Obsidian Absorption Base -->
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="28dp"
                android:topRightRadius="28dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <solid android:color="#E6080B10" />
        </shape>
    </item>

    <!-- Layer 1: Subtle Frost Glaze Gradient -->
    <item
        android:top="1.2dp"
        android:left="1.2dp"
        android:right="1.2dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="27dp"
                android:topRightRadius="27dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <gradient
                android:angle="270"
                android:startColor="#20FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#02FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- Layer 2: Top Edge Specular Glare Line -->
    <item
        android:top="1.2dp"
        android:left="40dp"
        android:right="40dp"
        android:bottom="80dp">
        <shape android:shape="rectangle">
            <corners android:radius="1dp" />
            <gradient
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#55FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- Layer 3: Specular Refractive Perimeter Rim -->
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="28dp"
                android:topRightRadius="28dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1.2dp"
                android:color="#35FFFFFF" />
        </shape>
    </item>
</layer-list>
