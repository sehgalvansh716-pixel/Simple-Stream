<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused or Activated state: Brightened Cinejoy matte specular glass with crisp 2dp white stroke -->
    <item android:state_focused="true">
        <layer-list>
            <!-- Frosted matte absorption base -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <solid android:color="#99060A10" />
                </shape>
            </item>
            <!-- Velvety satin diffusion layer -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <solid android:color="#331A2636" />
                </shape>
            </item>
            <!-- Specular glass gradient with crisp 2dp white outline -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#4DFFFFFF"
                        android:centerColor="#26FFFFFF"
                        android:endColor="#14FFFFFF" />
                    <stroke android:width="2dp" android:color="#FFFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_activated="true">
        <layer-list>
            <!-- Frosted matte absorption base -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <solid android:color="#99060A10" />
                </shape>
            </item>
            <!-- Velvety satin diffusion layer -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <solid android:color="#331A2636" />
                </shape>
            </item>
            <!-- Specular glass gradient with crisp 2dp white outline -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#4DFFFFFF"
                        android:centerColor="#26FFFFFF"
                        android:endColor="#14FFFFFF" />
                    <stroke android:width="2dp" android:color="#FFFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <solid android:color="#99060A10" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <solid android:color="#331A2636" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#4DFFFFFF"
                        android:centerColor="#26FFFFFF"
                        android:endColor="#14FFFFFF" />
                    <stroke android:width="2dp" android:color="#FFFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default state: Frosted matte Cinejoy glass with velvety diffusion and refractive border -->
    <item>
        <layer-list>
            <!-- Frosted matte absorption base: Softens sharp background video motion into smooth blurred depth -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <solid android:color="#8006090F" />
                </shape>
            </item>
            <!-- Satin matte diffusion layer simulating optical backdrop-blur -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <solid android:color="#24141E2C" />
                </shape>
            </item>
            <!-- Specular curved frosted glass gradient with refractive light-catching stroke -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#24FFFFFF"
                        android:centerColor="#10FFFFFF"
                        android:endColor="#06FFFFFF" />
                    <stroke android:width="1.2dp" android:color="#3DFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
