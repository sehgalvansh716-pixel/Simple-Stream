<?xml version="1.0" encoding="utf-8"?>
<!-- Interactive True-Liquid-Glass pill item background for selection dialogs and bottom sheets -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected / Activated State: Electric Indigo Glaze & Refractive Rim -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#266366F1" />
            <stroke
                android:width="1.2dp"
                android:color="#60818CF8" />
        </shape>
    </item>

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#266366F1" />
            <stroke
                android:width="1.2dp"
                android:color="#60818CF8" />
        </shape>
    </item>

    <!-- Pressed State: Luminous Glass Frost -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#22FFFFFF" />
            <stroke
                android:width="1.2dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>

    <!-- Focused State -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#1F818CF8" />
            <stroke
                android:width="1.2dp"
                android:color="#80818CF8" />
        </shape>
    </item>

    <!-- Default State: Subtle Translucent Glass Container -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#0DFFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#18FFFFFF" />
        </shape>
    </item>
</selector>
