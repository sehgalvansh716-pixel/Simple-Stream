<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: Pure bright white pill with crisp focus highlight -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <solid android:color="#FFFFFFFF" />
                    <stroke android:width="2.5dp" android:color="#80FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Pressed state: Slightly dimmed white -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <solid android:color="#E2E8F0" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default state: Pure Solid White Pill (Netflix / Cinejoy style) -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <solid android:color="#FFFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
